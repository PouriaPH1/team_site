@{ ViewData["Title"] = "404 – Page Not Found"; Layout = "~/Views/Shared/_Layout.cshtml"; }
<section class="section-wrapper text-center">
    <div class="container-main">
        <div style="font-size:5rem;font-weight:700;" class="text-gradient">404</div>
        <h1 style="font-size:clamp(1.5rem,3vw,2rem);margin:1rem 0 0.75rem;">Page Not Found</h1>
        <p style="color:var(--color-text-secondary);margin-bottom:2rem;">The page you're looking for doesn't exist or has been moved.</p>
        <a asp-controller="Home" asp-action="Index" class="btn-primary" style="cursor:pointer;">
            <i class="fa-solid fa-house" aria-hidden="true"></i> Back to Home
        </a>
    </div>
</section>
