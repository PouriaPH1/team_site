<!DOCTYPE html>
<html lang="fa" dir="ltr" data-theme="dark">
<head>
    <!-- Anti-flash: apply theme BEFORE any CSS renders to prevent white flash -->
    <script>
      (function() {
        var THEME_KEY = 'tp-theme';
        var saved = localStorage.getItem(THEME_KEY);
        var preferred = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', saved || preferred);
      })();
    </script>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Team Portfolio</title>
    @if (ViewData["MetaDescription"] != null)
    {
        <meta name="description" content="@ViewData["MetaDescription"]" />
    }
    @if (ViewData["OgTags"] is Dictionary<string, string> ogTags)
    {
        foreach (var tag in ogTags)
        {
            <meta property="@tag.Key" content="@tag.Value" />
        }
    }

    <!-- Font Awesome 6 Free -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
          crossorigin="anonymous" referrerpolicy="no-referrer" />

    <!-- Google Fonts: Manrope (heading) + IBM Plex Sans (body) + JetBrains Mono (code) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=IBM+Plex+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" />

    <!-- ═══ CSS Load Order (critical — do not reorder) ═══════════════════ -->
    <!-- 1. Design System — token source of truth -->
    <link rel="stylesheet" href="~/css/design-system.css" asp-append-version="true" />
    <!-- 2. Background System — cosmic starry night atmosphere -->
    <link rel="stylesheet" href="~/css/background-system.css" asp-append-version="true" />
    <!-- 3. Cosmic Decorations — SVG stars, curves, glows -->
    <link rel="stylesheet" href="~/css/cosmic-decorations.css" asp-append-version="true" />
    <!-- 4. Navigation — floating glass nav + mobile drawer -->
    <link rel="stylesheet" href="~/css/navigation.css" asp-append-version="true" />
    <!-- 5. Hero — full-viewport hero section -->
    <link rel="stylesheet" href="~/css/hero.css" asp-append-version="true" />
    <!-- 6. Motion — GPU promotions + scroll reveal + reduced-motion -->
    <link rel="stylesheet" href="~/css/motion.css" asp-append-version="true" />
    <!-- 7. Skills — constellation grid section -->
    <link rel="stylesheet" href="~/css/skills.css" asp-append-version="true" />
    <!-- 8. Terminal — terminal team explorer section -->
    <link rel="stylesheet" href="~/css/terminal.css" asp-append-version="true" />

    <!-- Bootstrap 5 -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Site-specific styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <!-- 9. Sections — transparent sections + Bootstrap dark overrides -->
    <link rel="stylesheet" href="~/css/sections.css" asp-append-version="true" />

    @await RenderSectionAsync("Head", required: false)
</head>
<body>

    <!-- Canvas star field — fixed behind all content (Req 2) -->
    <canvas id="star-canvas" aria-hidden="true"
            style="position:fixed;inset:0;z-index:-1;pointer-events:none;opacity:1"></canvas>

    <!-- Van Gogh Moon/Sun — fixed decorative element -->
    <div id="vangogh-moon" aria-hidden="true" style="position:fixed;top:8%;right:15%;z-index:-2;pointer-events:none;width:200px;height:200px;">
        <svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:100%;filter:blur(2px);">
            <!-- Outer halo -->
            <circle cx="100" cy="100" r="95" fill="url(#moon-gradient-outer)" opacity="0.25" />
            <!-- Mid glow -->
            <circle cx="100" cy="100" r="70" fill="url(#moon-gradient-mid)" opacity="0.45" />
            <!-- Core -->
            <circle cx="100" cy="100" r="45" fill="url(#moon-gradient-core)" opacity="0.85" />
            <!-- Inner bright core -->
            <circle cx="100" cy="100" r="25" fill="#FFF9E3" opacity="1" />
            
            <!-- Gradients -->
            <defs>
                <radialGradient id="moon-gradient-outer">
                    <stop offset="0%" style="stop-color:#F5C842;stop-opacity:0.5" />
                    <stop offset="100%" style="stop-color:#F5C842;stop-opacity:0" />
                </radialGradient>
                <radialGradient id="moon-gradient-mid">
                    <stop offset="0%" style="stop-color:#FFD700;stop-opacity:0.7" />
                    <stop offset="100%" style="stop-color:#F5C842;stop-opacity:0.1" />
                </radialGradient>
                <radialGradient id="moon-gradient-core">
                    <stop offset="0%" style="stop-color:#FFF9E3;stop-opacity:1" />
                    <stop offset="80%" style="stop-color:#FFD700;stop-opacity:0.8" />
                    <stop offset="100%" style="stop-color:#F5C842;stop-opacity:0.3" />
                </radialGradient>
            </defs>
        </svg>
    </div>

    <!-- Skip navigation — first focusable element in DOM (Req 12.2) -->
    <a href="#main-content" class="skip-nav">Skip to main content</a>

    <!-- ══════════════════════════════════════════════════════════
         BACKGROUND SYSTEM — Phase 1: empty, reserved for Phase 2 layers
    ══════════════════════════════════════════════════════════ -->
    <!-- Global starry-night atmosphere — fixed behind canvas + content -->
    <div id="background-system" aria-hidden="true"></div><!-- /#background-system -->

    <!-- Page loader: fades out once page is fully loaded -->
    <div id="page-loader" aria-hidden="true">
        <div class="loader-spinner"></div>
    </div>

    <!-- ══════════════════════════════════════════════════════════
         NAVIGATION (partial)
    ══════════════════════════════════════════════════════════ -->
    @await Html.PartialAsync("_Navigation")

    <!-- ══════════════════════════════════════════════════════════
         MAIN CONTENT
    ══════════════════════════════════════════════════════════ -->
    <main id="main-content" role="main">

        <!-- Breadcrumb (shown on all pages except Home) -->
        @if (ViewData["HideBreadcrumb"] == null || !(bool)ViewData["HideBreadcrumb"]!)
        {
            <div class="breadcrumb-wrapper">
                <div class="container-main" style="max-width:1200px;margin:0 auto;padding:0 1rem;">
                    <nav aria-label="Breadcrumb">
                        <ol class="breadcrumb-list">
                            <li class="breadcrumb-item">
                                <a asp-area="" asp-controller="Home" asp-action="Index" style="cursor:pointer;">
                                    <i class="fa-solid fa-house" aria-hidden="true"></i>
                                    <span class="visually-hidden">Home</span>
                                </a>
                            </li>
                            @if (ViewData["BreadcrumbItems"] is IEnumerable<(string Label, string? Url)> items)
                            {
                                foreach (var (label, url) in items)
                                {
                                    <li class="breadcrumb-item" aria-hidden="true">
                                        <i class="fa-solid fa-chevron-right breadcrumb-sep" aria-hidden="true"></i>
                                    </li>
                                    <li class="breadcrumb-item">
                                        @if (url != null)
                                        {
                                            <a href="@url" style="cursor:pointer;">@label</a>
                                        }
                                        else
                                        {
                                            <span aria-current="page">@label</span>
                                        }
                                    </li>
                                }
                            }
                            else
                            {
                                @if (ViewData["Title"] != null)
                                {
                                    <li class="breadcrumb-item" aria-hidden="true">
                                        <i class="fa-solid fa-chevron-right breadcrumb-sep" aria-hidden="true"></i>
                                    </li>
                                    <li class="breadcrumb-item">
                                        <span aria-current="page">@ViewData["Title"]</span>
                                    </li>
                                }
                            }
                        </ol>
                    </nav>
                </div>
            </div>
        }

        @RenderBody()

    </main>

    <!-- ══════════════════════════════════════════════════════════
         FOOTER
    ══════════════════════════════════════════════════════════ -->
    <footer class="site-footer" aria-label="Site footer">
        <div class="footer-inner" style="max-width:1200px;margin:0 auto;padding:0 1rem;">

            <div class="footer-grid">

                <!-- Column 1: Logo + Description -->
                <div class="footer-col footer-col-brand">
                    <a asp-area="" asp-controller="Home" asp-action="Index"
                       class="footer-logo text-gradient"
                       style="cursor:pointer;">
                        <i class="fa-solid fa-code me-2" aria-hidden="true"></i>TeamPortfolio
                    </a>
                    <p class="footer-desc">
                        A professional team of software engineers building modern web solutions.
                        We specialize in full-stack development, API design, and cloud architecture.
                    </p>
                    <div class="footer-social" aria-label="Social media links">
                        <a href="#" class="footer-social-link" aria-label="GitHub" style="cursor:pointer;">
                            <i class="fa-brands fa-github" aria-hidden="true"></i>
                        </a>
                        <a href="#" class="footer-social-link" aria-label="LinkedIn" style="cursor:pointer;">
                            <i class="fa-brands fa-linkedin" aria-hidden="true"></i>
                        </a>
                        <a href="#" class="footer-social-link" aria-label="Telegram" style="cursor:pointer;">
                            <i class="fa-brands fa-telegram" aria-hidden="true"></i>
                        </a>
                    </div>
                </div>

                <!-- Column 2: Quick Links -->
                <div class="footer-col">
                    <h3 class="footer-col-title">Quick Links</h3>
                    <ul class="footer-links list-unstyled mb-0">
                        <li><a asp-area="" asp-controller="Home" asp-action="Index" style="cursor:pointer;"><i class="fa-solid fa-house fa-fw" aria-hidden="true"></i> Home</a></li>
                        <li><a asp-area="" asp-controller="About" asp-action="Index" style="cursor:pointer;"><i class="fa-solid fa-circle-info fa-fw" aria-hidden="true"></i> About</a></li>
                        <li><a asp-area="" asp-controller="Team" asp-action="Index" style="cursor:pointer;"><i class="fa-solid fa-users fa-fw" aria-hidden="true"></i> Team</a></li>
                        <li><a asp-area="" asp-controller="Portfolio" asp-action="Index" style="cursor:pointer;"><i class="fa-solid fa-briefcase fa-fw" aria-hidden="true"></i> Portfolio</a></li>
                        <li><a asp-area="" asp-controller="Blog" asp-action="Index" style="cursor:pointer;"><i class="fa-solid fa-newspaper fa-fw" aria-hidden="true"></i> Blog</a></li>
                        <li><a asp-area="" asp-controller="Contact" asp-action="Index" style="cursor:pointer;"><i class="fa-solid fa-envelope fa-fw" aria-hidden="true"></i> Contact</a></li>
                    </ul>
                </div>

                <!-- Column 3: Services -->
                <div class="footer-col">
                    <h3 class="footer-col-title">Services</h3>
                    <ul class="footer-links list-unstyled mb-0">
                        <li><a href="#" style="cursor:pointer;"><i class="fa-solid fa-globe fa-fw" aria-hidden="true"></i> Web Development</a></li>
                        <li><a href="#" style="cursor:pointer;"><i class="fa-solid fa-plug fa-fw" aria-hidden="true"></i> API Design</a></li>
                        <li><a href="#" style="cursor:pointer;"><i class="fa-solid fa-cloud fa-fw" aria-hidden="true"></i> Cloud Solutions</a></li>
                        <li><a href="#" style="cursor:pointer;"><i class="fa-solid fa-mobile-screen fa-fw" aria-hidden="true"></i> Mobile Apps</a></li>
                    </ul>
                </div>

                <!-- Column 4: Connect -->
                <div class="footer-col">
                    <h3 class="footer-col-title">Connect</h3>
                    <ul class="footer-links list-unstyled mb-0">
                        <li><a href="https://github.com" target="_blank" rel="noopener noreferrer" style="cursor:pointer;"><i class="fa-brands fa-github fa-fw" aria-hidden="true"></i> GitHub</a></li>
                        <li><a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" style="cursor:pointer;"><i class="fa-brands fa-linkedin fa-fw" aria-hidden="true"></i> LinkedIn</a></li>
                        <li><a href="https://t.me" target="_blank" rel="noopener noreferrer" style="cursor:pointer;"><i class="fa-brands fa-telegram fa-fw" aria-hidden="true"></i> Telegram</a></li>
                        <li><a href="mailto:team@example.com" style="cursor:pointer;"><i class="fa-solid fa-envelope fa-fw" aria-hidden="true"></i> Email Us</a></li>
                    </ul>
                </div>

            </div><!-- /.footer-grid -->

            <div class="footer-bottom">
                <p class="footer-copyright">
                    &copy; @DateTime.Now.Year TeamPortfolio. All rights reserved.
                </p>
                <p class="footer-built">
                    Built with <i class="fa-solid fa-heart" style="color:var(--color-danger);" aria-label="love"></i>
                    using ASP.NET Core
                </p>
            </div>

        </div><!-- /.footer-inner -->
    </footer>

    <!-- ══════════════════════════════════════════════════════════
         SCRIPTS
    ══════════════════════════════════════════════════════════ -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/theme-toggle.js" asp-append-version="true"></script>
    <script src="~/js/notifications.js" asp-append-version="true"></script>

    <!-- Starry Night design system modules (deferred — load after DOM) -->
    <script src="~/js/background.js" asp-append-version="true" defer></script>
    <script src="~/js/motion.js" asp-append-version="true" defer></script>
    <script src="~/js/hero-interactions.js" asp-append-version="true" defer></script>
    <script src="~/js/canvas-stars.js" asp-append-version="true" defer></script>
    <script src="~/js/cosmic-decorations.js" asp-append-version="true" defer></script>
    <script src="~/js/terminal.js" asp-append-version="true" defer></script>

    <!-- Page loader hide script -->
    <script>
        window.addEventListener('load', function () {
            var loader = document.getElementById('page-loader');
            if (loader) {
                loader.style.opacity = '0';
                setTimeout(function () { loader.style.display = 'none'; }, 400);
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
