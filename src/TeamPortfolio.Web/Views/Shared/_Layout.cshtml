<!DOCTYPE html>
<html lang="fa" dir="ltr" data-theme="dark">
<head>
    <!-- Anti-flash: apply theme BEFORE any CSS renders to prevent white flash -->
    <script>
      (function() {
        var THEME_KEY = 'tp-theme';
        var saved = localStorage.getItem(THEME_KEY);
        var preferred = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', saved || preferred);
      })();
    </script>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Team Portfolio</title>
    @if (ViewData["MetaDescription"] != null)
    {
        <meta name="description" content="@ViewData["MetaDescription"]" />
    }
    @if (ViewData["OgTags"] is Dictionary<string, string> ogTags)
    {
        foreach (var tag in ogTags)
        {
            <meta property="@tag.Key" content="@tag.Value" />
        }
    }

    <!-- Font Awesome 6 Free -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
          integrity="sha512-Avb2QiuDEEvB4bZJYdft2mNjVShBftLdPG8FJ0V7irTLQ8Uu0qcPxh4Plh7eecsDwtR3PTxyYDAfuZJHoYOPw=="
          crossorigin="anonymous" referrerpolicy="no-referrer" />

    <!-- Google Fonts: Space Grotesk (heading) + DM Sans (body) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,700;1,9..40,400&display=swap" />

    <!-- Design System (CSS variables, typography, components) -->
    <link rel="stylesheet" href="~/css/design-system.css" asp-append-version="true" />

    <!-- Bootstrap 5 -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Site-specific styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @await RenderSectionAsync("Head", required: false)
</head>
<body>

    <!-- Page loader: fades out once page is fully loaded -->
    <div id="page-loader" aria-hidden="true">
        <div class="loader-spinner"></div>
    </div>

    <!-- ══════════════════════════════════════════════════════════
         NAVBAR
    ══════════════════════════════════════════════════════════ -->
    <header>
        <nav class="navbar" id="main-navbar" aria-label="Main navigation">
            <div class="container-main d-flex align-items-center justify-content-between w-100" style="max-width:1200px;margin:0 auto;padding:0 1rem;">

                <!-- Brand / Logo -->
                <a class="navbar-brand-logo text-gradient fw-bold"
                   asp-area="" asp-controller="Home" asp-action="Index"
                   style="font-family:var(--font-heading);font-size:1.25rem;font-weight:700;text-decoration:none;cursor:pointer;">
                    <i class="fa-solid fa-code me-2" aria-hidden="true"></i>TeamPortfolio
                </a>

                <!-- Desktop Nav Links -->
                <ul class="nav-links d-none d-lg-flex align-items-center list-unstyled mb-0 gap-1">
                    <li>
                        <a class="nav-link-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")"
                           asp-area="" asp-controller="Home" asp-action="Index">
                            <i class="fa-solid fa-house fa-fw" aria-hidden="true"></i>
                            <span>Home</span>
                        </a>
                    </li>
                    <li>
                        <a class="nav-link-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "About" ? "active" : "")"
                           asp-area="" asp-controller="About" asp-action="Index">
                            <i class="fa-solid fa-circle-info fa-fw" aria-hidden="true"></i>
                            <span>About</span>
                        </a>
                    </li>
                    <li>
                        <a class="nav-link-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Team" ? "active" : "")"
                           asp-area="" asp-controller="Team" asp-action="Index">
                            <i class="fa-solid fa-users fa-fw" aria-hidden="true"></i>
                            <span>Team</span>
                        </a>
                    </li>
                    <li>
                        <a class="nav-link-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Portfolio" ? "active" : "")"
                           asp-area="" asp-controller="Portfolio" asp-action="Index">
                            <i class="fa-solid fa-briefcase fa-fw" aria-hidden="true"></i>
                            <span>Portfolio</span>
                        </a>
                    </li>
                    <li>
                        <a class="nav-link-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Blog" ? "active" : "")"
                           asp-area="" asp-controller="Blog" asp-action="Index">
                            <i class="fa-solid fa-newspaper fa-fw" aria-hidden="true"></i>
                            <span>Blog</span>
                        </a>
                    </li>
                    <li>
                        <a class="nav-link-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Contact" ? "active" : "")"
                           asp-area="" asp-controller="Contact" asp-action="Index">
                            <i class="fa-solid fa-envelope fa-fw" aria-hidden="true"></i>
                            <span>Contact</span>
                        </a>
                    </li>
                </ul>

                <!-- Navbar Actions (right side) -->
                <div class="d-flex align-items-center gap-2">

                    <!-- Search button -->
                    <a asp-area="" asp-controller="Search" asp-action="Index"
                       class="btn-ghost d-none d-md-inline-flex align-items-center"
                       aria-label="Search"
                       style="cursor:pointer;">
                        <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                    </a>

                    <!-- Dark/Light Toggle -->
                    <button id="theme-toggle-btn"
                            class="btn-ghost"
                            aria-label="Switch to light mode"
                            style="cursor:pointer;">
                        <i class="fa-solid fa-moon" aria-hidden="true"></i>
                    </button>

                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index"
                           class="btn-primary d-none d-md-inline-flex"
                           style="padding:7px 16px;font-size:0.875rem;cursor:pointer;">
                            <i class="fa-solid fa-gauge-high" aria-hidden="true"></i>
                            <span>Dashboard</span>
                        </a>
                    }
                    else
                    {
                        <a asp-area="" asp-controller="Account" asp-action="Login"
                           class="btn-secondary d-none d-md-inline-flex"
                           style="padding:7px 16px;font-size:0.875rem;cursor:pointer;">
                            <i class="fa-solid fa-right-to-bracket" aria-hidden="true"></i>
                            <span>Login</span>
                        </a>
                    }

                    <!-- Mobile Hamburger -->
                    <button id="mobile-menu-btn"
                            class="btn-ghost d-flex d-lg-none align-items-center"
                            aria-label="Open menu"
                            aria-expanded="false"
                            aria-controls="mobile-drawer"
                            style="cursor:pointer;">
                        <i class="fa-solid fa-bars" aria-hidden="true"></i>
                    </button>
                </div>

            </div>
        </nav>
    </header>

    <!-- ══════════════════════════════════════════════════════════
         MOBILE SLIDE-IN DRAWER
    ══════════════════════════════════════════════════════════ -->
    <div id="mobile-drawer-overlay" aria-hidden="true"></div>
    <nav id="mobile-drawer"
         aria-label="Mobile navigation"
         aria-hidden="true"
         role="dialog"
         aria-modal="true">

        <div class="mobile-drawer-header">
            <span class="text-gradient fw-bold" style="font-family:var(--font-heading);font-size:1.125rem;">
                <i class="fa-solid fa-code me-2" aria-hidden="true"></i>TeamPortfolio
            </span>
            <button id="mobile-drawer-close"
                    class="btn-ghost"
                    aria-label="Close menu"
                    style="cursor:pointer;">
                <i class="fa-solid fa-xmark" aria-hidden="true"></i>
            </button>
        </div>

        <ul class="mobile-nav-links list-unstyled mb-0">
            <li>
                <a class="mobile-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")"
                   asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="fa-solid fa-house fa-fw" aria-hidden="true"></i>
                    <span>Home</span>
                </a>
            </li>
            <li>
                <a class="mobile-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "About" ? "active" : "")"
                   asp-area="" asp-controller="About" asp-action="Index">
                    <i class="fa-solid fa-circle-info fa-fw" aria-hidden="true"></i>
                    <span>About</span>
                </a>
            </li>
            <li>
                <a class="mobile-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Team" ? "active" : "")"
                   asp-area="" asp-controller="Team" asp-action="Index">
                    <i class="fa-solid fa-users fa-fw" aria-hidden="true"></i>
                    <span>Team</span>
                </a>
            </li>
            <li>
                <a class="mobile-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Portfolio" ? "active" : "")"
                   asp-area="" asp-controller="Portfolio" asp-action="Index">
                    <i class="fa-solid fa-briefcase fa-fw" aria-hidden="true"></i>
                    <span>Portfolio</span>
                </a>
            </li>
            <li>
                <a class="mobile-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Blog" ? "active" : "")"
                   asp-area="" asp-controller="Blog" asp-action="Index">
                    <i class="fa-solid fa-newspaper fa-fw" aria-hidden="true"></i>
                    <span>Blog</span>
                </a>
            </li>
            <li>
                <a class="mobile-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Contact" ? "active" : "")"
                   asp-area="" asp-controller="Contact" asp-action="Index">
                    <i class="fa-solid fa-envelope fa-fw" aria-hidden="true"></i>
                    <span>Contact</span>
                </a>
            </li>
            <li>
                <a class="mobile-nav-link"
                   asp-area="" asp-controller="Search" asp-action="Index">
                    <i class="fa-solid fa-magnifying-glass fa-fw" aria-hidden="true"></i>
                    <span>Search</span>
                </a>
            </li>
        </ul>

        <div class="mobile-drawer-footer">
            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index"
                   class="btn-primary w-100 justify-content-center"
                   style="cursor:pointer;">
                    <i class="fa-solid fa-gauge-high" aria-hidden="true"></i>
                    <span>Dashboard</span>
                </a>
            }
            else
            {
                <a asp-area="" asp-controller="Account" asp-action="Login"
                   class="btn-secondary w-100 justify-content-center"
                   style="cursor:pointer;">
                    <i class="fa-solid fa-right-to-bracket" aria-hidden="true"></i>
                    <span>Login</span>
                </a>
            }
        </div>
    </nav>

    <!-- ══════════════════════════════════════════════════════════
         MAIN CONTENT
    ══════════════════════════════════════════════════════════ -->
    <main id="main-content" role="main">

        <!-- Breadcrumb (shown on all pages except Home) -->
        @if (ViewData["HideBreadcrumb"] == null || !(bool)ViewData["HideBreadcrumb"]!)
        {
            <div class="breadcrumb-wrapper">
                <div class="container-main" style="max-width:1200px;margin:0 auto;padding:0 1rem;">
                    <nav aria-label="Breadcrumb">
                        <ol class="breadcrumb-list">
                            <li class="breadcrumb-item">
                                <a asp-area="" asp-controller="Home" asp-action="Index" style="cursor:pointer;">
                                    <i class="fa-solid fa-house" aria-hidden="true"></i>
                                    <span class="visually-hidden">Home</span>
                                </a>
                            </li>
                            @if (ViewData["BreadcrumbItems"] is IEnumerable<(string Label, string? Url)> items)
                            {
                                foreach (var (label, url) in items)
                                {
                                    <li class="breadcrumb-item" aria-hidden="true">
                                        <i class="fa-solid fa-chevron-right breadcrumb-sep" aria-hidden="true"></i>
                                    </li>
                                    <li class="breadcrumb-item">
                                        @if (url != null)
                                        {
                                            <a href="@url" style="cursor:pointer;">@label</a>
                                        }
                                        else
                                        {
                                            <span aria-current="page">@label</span>
                                        }
                                    </li>
                                }
                            }
                            else
                            {
                                <!-- Fallback: derive label from ViewData["Title"] -->
                                @if (ViewData["Title"] != null)
                                {
                                    <li class="breadcrumb-item" aria-hidden="true">
                                        <i class="fa-solid fa-chevron-right breadcrumb-sep" aria-hidden="true"></i>
                                    </li>
                                    <li class="breadcrumb-item">
                                        <span aria-current="page">@ViewData["Title"]</span>
                                    </li>
                                }
                            }
                        </ol>
                    </nav>
                </div>
            </div>
        }

        @RenderBody()

    </main>

    <!-- ══════════════════════════════════════════════════════════
         FOOTER
    ══════════════════════════════════════════════════════════ -->
    <footer class="site-footer" aria-label="Site footer">
        <div class="footer-inner" style="max-width:1200px;margin:0 auto;padding:0 1rem;">

            <div class="footer-grid">

                <!-- Column 1: Logo + Description -->
                <div class="footer-col footer-col-brand">
                    <a asp-area="" asp-controller="Home" asp-action="Index"
                       class="footer-logo text-gradient"
                       style="cursor:pointer;">
                        <i class="fa-solid fa-code me-2" aria-hidden="true"></i>TeamPortfolio
                    </a>
                    <p class="footer-desc">
                        A professional team of software engineers building modern web solutions.
                        We specialize in full-stack development, API design, and cloud architecture.
                    </p>
                    <!-- Social links -->
                    <div class="footer-social" aria-label="Social media links">
                        <a href="#" class="footer-social-link" aria-label="GitHub" style="cursor:pointer;">
                            <i class="fa-brands fa-github" aria-hidden="true"></i>
                        </a>
                        <a href="#" class="footer-social-link" aria-label="LinkedIn" style="cursor:pointer;">
                            <i class="fa-brands fa-linkedin" aria-hidden="true"></i>
                        </a>
                        <a href="#" class="footer-social-link" aria-label="Telegram" style="cursor:pointer;">
                            <i class="fa-brands fa-telegram" aria-hidden="true"></i>
                        </a>
                    </div>
                </div>

                <!-- Column 2: Quick Links -->
                <div class="footer-col">
                    <h3 class="footer-col-title">Quick Links</h3>
                    <ul class="footer-links list-unstyled mb-0">
                        <li>
                            <a asp-area="" asp-controller="Home" asp-action="Index" style="cursor:pointer;">
                                <i class="fa-solid fa-house fa-fw" aria-hidden="true"></i> Home
                            </a>
                        </li>
                        <li>
                            <a asp-area="" asp-controller="About" asp-action="Index" style="cursor:pointer;">
                                <i class="fa-solid fa-circle-info fa-fw" aria-hidden="true"></i> About
                            </a>
                        </li>
                        <li>
                            <a asp-area="" asp-controller="Team" asp-action="Index" style="cursor:pointer;">
                                <i class="fa-solid fa-users fa-fw" aria-hidden="true"></i> Team
                            </a>
                        </li>
                        <li>
                            <a asp-area="" asp-controller="Portfolio" asp-action="Index" style="cursor:pointer;">
                                <i class="fa-solid fa-briefcase fa-fw" aria-hidden="true"></i> Portfolio
                            </a>
                        </li>
                        <li>
                            <a asp-area="" asp-controller="Blog" asp-action="Index" style="cursor:pointer;">
                                <i class="fa-solid fa-newspaper fa-fw" aria-hidden="true"></i> Blog
                            </a>
                        </li>
                        <li>
                            <a asp-area="" asp-controller="Contact" asp-action="Index" style="cursor:pointer;">
                                <i class="fa-solid fa-envelope fa-fw" aria-hidden="true"></i> Contact
                            </a>
                        </li>
                    </ul>
                </div>

                <!-- Column 3: Services -->
                <div class="footer-col">
                    <h3 class="footer-col-title">Services</h3>
                    <ul class="footer-links list-unstyled mb-0">
                        <li>
                            <a href="#" style="cursor:pointer;">
                                <i class="fa-solid fa-globe fa-fw" aria-hidden="true"></i> Web Development
                            </a>
                        </li>
                        <li>
                            <a href="#" style="cursor:pointer;">
                                <i class="fa-solid fa-plug fa-fw" aria-hidden="true"></i> API Design
                            </a>
                        </li>
                        <li>
                            <a href="#" style="cursor:pointer;">
                                <i class="fa-solid fa-cloud fa-fw" aria-hidden="true"></i> Cloud Solutions
                            </a>
                        </li>
                        <li>
                            <a href="#" style="cursor:pointer;">
                                <i class="fa-solid fa-mobile-screen fa-fw" aria-hidden="true"></i> Mobile Apps
                            </a>
                        </li>
                    </ul>
                </div>

                <!-- Column 4: Contact / Social -->
                <div class="footer-col">
                    <h3 class="footer-col-title">Connect</h3>
                    <ul class="footer-links list-unstyled mb-0">
                        <li>
                            <a href="https://github.com" target="_blank" rel="noopener noreferrer" style="cursor:pointer;">
                                <i class="fa-brands fa-github fa-fw" aria-hidden="true"></i> GitHub
                            </a>
                        </li>
                        <li>
                            <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" style="cursor:pointer;">
                                <i class="fa-brands fa-linkedin fa-fw" aria-hidden="true"></i> LinkedIn
                            </a>
                        </li>
                        <li>
                            <a href="https://t.me" target="_blank" rel="noopener noreferrer" style="cursor:pointer;">
                                <i class="fa-brands fa-telegram fa-fw" aria-hidden="true"></i> Telegram
                            </a>
                        </li>
                        <li>
                            <a href="mailto:team@example.com" style="cursor:pointer;">
                                <i class="fa-solid fa-envelope fa-fw" aria-hidden="true"></i> Email Us
                            </a>
                        </li>
                    </ul>
                </div>

            </div><!-- /.footer-grid -->

            <div class="footer-bottom">
                <p class="footer-copyright">
                    &copy; @DateTime.Now.Year TeamPortfolio. All rights reserved.
                </p>
                <p class="footer-built">
                    Built with <i class="fa-solid fa-heart" style="color:var(--color-danger);" aria-label="love"></i>
                    using ASP.NET Core
                </p>
            </div>

        </div><!-- /.footer-inner -->
    </footer>

    <!-- ══════════════════════════════════════════════════════════
         SCRIPTS
    ══════════════════════════════════════════════════════════ -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/theme-toggle.js" asp-append-version="true"></script>
    <script src="~/js/notifications.js" asp-append-version="true"></script>

    <!-- Page loader hide script -->
    <script>
        window.addEventListener('load', function () {
            var loader = document.getElementById('page-loader');
            if (loader) {
                loader.style.opacity = '0';
                setTimeout(function () { loader.style.display = 'none'; }, 400);
            }
        });
    </script>

    <!-- Mobile Drawer Script -->
    <script>
    (function () {
        'use strict';
        var btn     = document.getElementById('mobile-menu-btn');
        var drawer  = document.getElementById('mobile-drawer');
        var overlay = document.getElementById('mobile-drawer-overlay');
        var closeBtn = document.getElementById('mobile-drawer-close');

        function openDrawer() {
            drawer.classList.add('open');
            overlay.classList.add('show');
            document.body.classList.add('drawer-open');
            btn.setAttribute('aria-expanded', 'true');
            drawer.setAttribute('aria-hidden', 'false');
            closeBtn.focus();
        }

        function closeDrawer() {
            drawer.classList.remove('open');
            overlay.classList.remove('show');
            document.body.classList.remove('drawer-open');
            btn.setAttribute('aria-expanded', 'false');
            drawer.setAttribute('aria-hidden', 'true');
            btn.focus();
        }

        if (btn)     btn.addEventListener('click', openDrawer);
        if (closeBtn) closeBtn.addEventListener('click', closeDrawer);
        if (overlay) overlay.addEventListener('click', closeDrawer);

        // Close on Escape
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && drawer && drawer.classList.contains('open')) {
                closeDrawer();
            }
        });
    })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
