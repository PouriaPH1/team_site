@* _Navigation.cshtml — Floating glass navigation partial
   Replaces the inline <nav> block in _Layout.cshtml.
   Preserves all existing asp-controller/asp-action tag helpers and
   ViewContext.RouteData active-state detection logic.
   Requirements: 7.1–7.7, 8.1–8.5, 12.2, 12.4, 13.1, 15.3
*@

@{
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
}

<header class="nav-header">
    <nav id="main-navbar" aria-label="Main navigation">

        <!-- ── Logo ─────────────────────────────────────────── -->
        <a class="nav-brand"
           asp-area="" asp-controller="Home" asp-action="Index"
           aria-label="TeamPortfolio — go to homepage">
            <svg class="nav-logo-dots"
                 viewBox="0 0 32 32"
                 xmlns="http://www.w3.org/2000/svg"
                 aria-hidden="true" focusable="false">
                <circle class="nav-logo-dot" cx="6"  cy="6"  r="2.5" />
                <circle class="nav-logo-dot" cx="16" cy="4"  r="2"   style="animation-delay:-0.8s;" />
                <circle class="nav-logo-dot" cx="26" cy="8"  r="1.5" style="animation-delay:-1.6s;" />
                <circle class="nav-logo-dot" cx="28" cy="18" r="2"   style="animation-delay:-0.4s;" />
                <circle class="nav-logo-dot" cx="20" cy="27" r="1.5" style="animation-delay:-1.2s;" />
                <circle class="nav-logo-dot" cx="8"  cy="24" r="2"   style="animation-delay:-2.0s;" />
                <line class="nav-logo-line" x1="6"  y1="6"  x2="16" y2="4"  />
                <line class="nav-logo-line" x1="16" y1="4"  x2="26" y2="8"  />
                <line class="nav-logo-line" x1="26" y1="8"  x2="28" y2="18" />
                <line class="nav-logo-line" x1="28" y1="18" x2="20" y2="27" />
                <line class="nav-logo-line" x1="20" y1="27" x2="8"  y2="24" />
                <line class="nav-logo-line" x1="8"  y1="24" x2="6"  y2="6"  />
            </svg>
            <span class="text-gradient nav-brand-name">TeamPortfolio</span>
        </a>

        <!-- ── Desktop Nav Links ─────────────────────────────── -->
        <ul class="nav-links" role="list">
            <li>
                <a class="nav-link-item @(ctrl == "Home" ? "active" : "")"
                   asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="fa-solid fa-house fa-fw" aria-hidden="true"></i>
                    <span>Home</span>
                </a>
            </li>
            <li>
                <a class="nav-link-item @(ctrl == "About" ? "active" : "")"
                   asp-area="" asp-controller="About" asp-action="Index">
                    <i class="fa-solid fa-circle-info fa-fw" aria-hidden="true"></i>
                    <span>About</span>
                </a>
            </li>
            <li>
                <a class="nav-link-item @(ctrl == "Team" ? "active" : "")"
                   asp-area="" asp-controller="Team" asp-action="Index">
                    <i class="fa-solid fa-users fa-fw" aria-hidden="true"></i>
                    <span>Team</span>
                </a>
            </li>
            <li>
                <a class="nav-link-item @(ctrl == "Portfolio" ? "active" : "")"
                   asp-area="" asp-controller="Portfolio" asp-action="Index">
                    <i class="fa-solid fa-briefcase fa-fw" aria-hidden="true"></i>
                    <span>Portfolio</span>
                </a>
            </li>
            <li>
                <a class="nav-link-item @(ctrl == "Blog" ? "active" : "")"
                   asp-area="" asp-controller="Blog" asp-action="Index">
                    <i class="fa-solid fa-newspaper fa-fw" aria-hidden="true"></i>
                    <span>Blog</span>
                </a>
            </li>
            <li>
                <a class="nav-link-item @(ctrl == "Contact" ? "active" : "")"
                   asp-area="" asp-controller="Contact" asp-action="Index">
                    <i class="fa-solid fa-envelope fa-fw" aria-hidden="true"></i>
                    <span>Contact</span>
                </a>
            </li>
        </ul>

        <!-- ── Right Actions ─────────────────────────────────── -->
        <div class="nav-actions">

            <!-- Search -->
            <a asp-area="" asp-controller="Search" asp-action="Index"
               class="btn-ghost nav-search-btn"
               aria-label="Search">
                <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
            </a>

            <!-- "Let's Talk" magnetic CTA -->
            <a asp-area="" asp-controller="Contact" asp-action="Index"
               class="nav-cta-magnetic">
                <i class="fa-solid fa-paper-plane" aria-hidden="true"></i>
                <span>Let's Talk</span>
            </a>

            <!-- Dark-mode toggle (decorative in this phase — dark-only design) -->
            <button class="nav-theme-toggle"
                    id="theme-toggle-btn"
                    aria-label="Toggle theme"
                    type="button">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                     xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                    <path d="M21 12.79A9 9 0 1111.21 3a7 7 0 109.79 9.79z"
                          fill="currentColor" />
                </svg>
            </button>

            <!-- Dashboard (admin only — login link is intentionally hidden from public UI) -->
            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index"
                   class="btn-primary nav-auth-btn"
                   style="padding:7px 16px;font-size:0.875rem;">
                    <i class="fa-solid fa-gauge-high" aria-hidden="true"></i>
                    <span>Dashboard</span>
                </a>
            }

            <!-- Mobile hamburger toggle -->
            <button class="nav-hamburger"
                    id="mobile-menu-btn"
                    type="button"
                    aria-label="Open navigation menu"
                    aria-expanded="false"
                    aria-controls="mobile-drawer">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                     xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                    <line x1="3" y1="6"  x2="21" y2="6"  stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                    <line x1="3" y1="12" x2="21" y2="12" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                    <line x1="3" y1="18" x2="21" y2="18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                </svg>
            </button>
        </div>

    </nav>
</header>

<!-- ══════════════════════════════════════════════════════════
     MOBILE SLIDE-IN DRAWER
══════════════════════════════════════════════════════════ -->
<div id="mobile-drawer-overlay" aria-hidden="true"></div>

<nav id="mobile-drawer"
     aria-label="Mobile navigation"
     aria-hidden="true"
     role="dialog"
     aria-modal="true">

    <div class="mobile-drawer-header">
        <span class="text-gradient" style="font-family:var(--font-heading);font-size:1.125rem;font-weight:700;">
            <i class="fa-solid fa-code me-2" aria-hidden="true"></i>TeamPortfolio
        </span>
        <button class="btn-ghost mobile-drawer-close"
                id="mobile-drawer-close"
                type="button"
                aria-label="Close navigation menu">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                 xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                <line x1="18" y1="6" x2="6" y2="18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                <line x1="6"  y1="6" x2="18" y2="18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
            </svg>
        </button>
    </div>

    <ul class="mobile-nav-links" role="list">
        <li>
            <a class="mobile-nav-link @(ctrl == "Home" ? "active" : "")"
               asp-area="" asp-controller="Home" asp-action="Index">
                <i class="fa-solid fa-house fa-fw" aria-hidden="true"></i>
                <span>Home</span>
            </a>
        </li>
        <li>
            <a class="mobile-nav-link @(ctrl == "About" ? "active" : "")"
               asp-area="" asp-controller="About" asp-action="Index">
                <i class="fa-solid fa-circle-info fa-fw" aria-hidden="true"></i>
                <span>About</span>
            </a>
        </li>
        <li>
            <a class="mobile-nav-link @(ctrl == "Team" ? "active" : "")"
               asp-area="" asp-controller="Team" asp-action="Index">
                <i class="fa-solid fa-users fa-fw" aria-hidden="true"></i>
                <span>Team</span>
            </a>
        </li>
        <li>
            <a class="mobile-nav-link @(ctrl == "Portfolio" ? "active" : "")"
               asp-area="" asp-controller="Portfolio" asp-action="Index">
                <i class="fa-solid fa-briefcase fa-fw" aria-hidden="true"></i>
                <span>Portfolio</span>
            </a>
        </li>
        <li>
            <a class="mobile-nav-link @(ctrl == "Blog" ? "active" : "")"
               asp-area="" asp-controller="Blog" asp-action="Index">
                <i class="fa-solid fa-newspaper fa-fw" aria-hidden="true"></i>
                <span>Blog</span>
            </a>
        </li>
        <li>
            <a class="mobile-nav-link @(ctrl == "Contact" ? "active" : "")"
               asp-area="" asp-controller="Contact" asp-action="Index">
                <i class="fa-solid fa-envelope fa-fw" aria-hidden="true"></i>
                <span>Contact</span>
            </a>
        </li>
        <li>
            <a class="mobile-nav-link"
               asp-area="" asp-controller="Search" asp-action="Index">
                <i class="fa-solid fa-magnifying-glass fa-fw" aria-hidden="true"></i>
                <span>Search</span>
            </a>
        </li>
    </ul>

    <div class="mobile-drawer-footer">
        @if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index"
               class="btn-primary w-100 justify-content-center">
                <i class="fa-solid fa-gauge-high" aria-hidden="true"></i>
                <span>Dashboard</span>
            </a>
        }
        <!-- Theme toggle — available on mobile too -->
        <button class="nav-theme-toggle mobile-drawer-theme-toggle"
                id="mobile-theme-toggle-btn"
                aria-label="Toggle theme"
                type="button">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                 xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                <path d="M21 12.79A9 9 0 1111.21 3a7 7 0 109.79 9.79z"
                      fill="currentColor" />
            </svg>
            <span style="font-size:0.85rem;font-family:var(--font-body);margin-left:8px;color:rgba(248,244,232,0.60);">Toggle Theme</span>
        </button>
    </div>

</nav>

<!-- nav-brand styles (inline — minimal, scoped to this partial) -->
<style>
.nav-brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
    flex-shrink: 0;
}
.nav-brand-name {
    font-family: var(--font-heading);
    font-size: 1.125rem;
    font-weight: 700;
}
.nav-actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
}
.nav-search-btn,
.nav-auth-btn {
    display: none;
}
@@media (min-width: 768px) {
    .nav-search-btn,
    .nav-auth-btn {
        display: inline-flex;
    }
}
</style>
