@model TeamPortfolio.Web.ViewModels.Blog.BlogPostViewModel
@{
    ViewData["Title"] = Model.Post.Title;
}

<section class="section-wrapper">
    <div class="container-main">
        <div class="row g-5">

            <!-- Article -->
            <div class="col-lg-8">
                @if (!string.IsNullOrEmpty(Model.Post.CoverImagePath))
                {
                    <img src="@Model.Post.CoverImagePath"
                         alt="@Model.Post.Title"
                         style="width:100%;border-radius:var(--radius-lg);margin-bottom:2rem;max-height:400px;object-fit:cover;"
                         loading="lazy" />
                }

                <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:1rem;">
                    <span class="badge badge-primary">@Model.Post.CategoryName</span>
                    <span style="font-size:0.875rem;color:var(--color-text-muted);">
                        <i class="fa-solid fa-user fa-fw" aria-hidden="true"></i> @Model.Post.AuthorName
                    </span>
                    @if (Model.Post.PublishDate.HasValue)
                    {
                        <span style="font-size:0.875rem;color:var(--color-text-muted);">
                            <i class="fa-regular fa-calendar fa-fw" aria-hidden="true"></i>
                            @Model.Post.PublishDate.Value.ToString("MMM dd, yyyy")
                        </span>
                    }
                    <span style="font-size:0.875rem;color:var(--color-text-muted);">
                        <i class="fa-solid fa-eye fa-fw" aria-hidden="true"></i> @Model.Post.ViewCount views
                    </span>
                </div>

                <h1 style="font-size:clamp(1.5rem,3vw,2.25rem);margin-bottom:2rem;">@Model.Post.Title</h1>

                <!-- Article body -->
                <div style="color:var(--color-text-secondary);line-height:1.8;font-size:1.0625rem;">
                    @Html.Raw(Model.Post.Body)
                </div>

                <!-- Comments section -->
                <div style="margin-top:4rem;padding-top:2rem;border-top:1px solid var(--color-border);">
                    <h2 style="font-size:1.25rem;margin-bottom:1.5rem;">
                        <i class="fa-solid fa-comments me-2"
                           style="color:var(--color-primary);"
                           aria-hidden="true"></i>
                        Comments (@Model.Comments.Count())
                    </h2>

                    @if (TempData["CommentSuccess"] != null)
                    {
                        <div class="card" style="border-left:4px solid var(--color-success);cursor:default;margin-bottom:1.5rem;">
                            <p style="margin:0;color:var(--color-success);">
                                <i class="fa-solid fa-circle-check me-2" aria-hidden="true"></i>
                                @TempData["CommentSuccess"]
                            </p>
                        </div>
                    }

                    @if (Model.Comments.Any())
                    {
                        @foreach (var comment in Model.Comments)
                        {
                            <div class="card mb-3" style="cursor:default;">
                                <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.75rem;">
                                    <strong style="font-size:0.9rem;">@comment.CommenterName</strong>
                                    <span style="font-size:0.8rem;color:var(--color-text-muted);">
                                        @comment.CreatedAt.ToString("MMM dd, yyyy")
                                    </span>
                                </div>
                                <p style="color:var(--color-text-secondary);line-height:1.7;margin:0;">@comment.Body</p>
                            </div>
                        }
                    }
                    else
                    {
                        <p style="color:var(--color-text-muted);">No comments yet. Be the first!</p>
                    }

                    <!-- Comment form -->
                    <div style="margin-top:2rem;">
                        <h3 style="font-size:1.1rem;margin-bottom:1.25rem;">Leave a Comment</h3>
                        <form asp-action="SubmitComment"
                              asp-route-slug="@ViewContext.RouteData.Values["slug"]"
                              method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" asp-for="CommentForm.PostId" />

                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label asp-for="CommentForm.CommenterName"
                                           class="form-label"
                                           style="font-size:0.875rem;color:var(--color-text-secondary);">
                                        Name *
                                    </label>
                                    <input asp-for="CommentForm.CommenterName"
                                           class="form-control"
                                           placeholder="Your name" />
                                    <span asp-validation-for="CommentForm.CommenterName"
                                          style="color:var(--color-danger);font-size:0.8rem;"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="CommentForm.CommenterEmail"
                                           class="form-label"
                                           style="font-size:0.875rem;color:var(--color-text-secondary);">
                                        Email *
                                    </label>
                                    <input asp-for="CommentForm.CommenterEmail"
                                           class="form-control"
                                           placeholder="your@email.com" />
                                    <span asp-validation-for="CommentForm.CommenterEmail"
                                          style="color:var(--color-danger);font-size:0.8rem;"></span>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label asp-for="CommentForm.Body"
                                       class="form-label"
                                       style="font-size:0.875rem;color:var(--color-text-secondary);">
                                    Comment *
                                </label>
                                <textarea asp-for="CommentForm.Body"
                                          class="form-control"
                                          rows="4"
                                          placeholder="Write your comment here..."></textarea>
                                <span asp-validation-for="CommentForm.Body"
                                      style="color:var(--color-danger);font-size:0.8rem;"></span>
                            </div>

                            <button type="submit" class="btn-primary" style="cursor:pointer;">
                                <i class="fa-solid fa-paper-plane" aria-hidden="true"></i> Submit Comment
                            </button>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Sidebar -->
            <div class="col-lg-4">
                @if (Model.RelatedPosts.Any())
                {
                    <div class="card" style="cursor:default;position:sticky;top:80px;">
                        <h3 style="font-size:1rem;font-weight:600;color:var(--color-text-muted);text-transform:uppercase;letter-spacing:0.05em;margin-bottom:1.25rem;">
                            <i class="fa-solid fa-link me-2" aria-hidden="true"></i>Related Posts
                        </h3>
                        @foreach (var related in Model.RelatedPosts)
                        {
                            <a asp-action="Post" asp-route-slug="@related.Slug"
                               class="text-decoration-none"
                               style="display:block;padding:0.75rem 0;border-bottom:1px solid var(--color-border);cursor:pointer;">
                                <div style="font-size:0.9rem;font-weight:500;color:var(--color-text);margin-bottom:0.25rem;">
                                    @related.Title
                                </div>
                                <div style="font-size:0.8rem;color:var(--color-text-muted);">
                                    <i class="fa-solid fa-user fa-fw" aria-hidden="true"></i> @related.AuthorName
                                </div>
                            </a>
                        }
                        <a asp-action="Index"
                           class="btn-ghost mt-3 d-block text-center"
                           style="cursor:pointer;">
                            <i class="fa-solid fa-arrow-left me-1" aria-hidden="true"></i> All Posts
                        </a>
                    </div>
                }
            </div>

        </div>
    </div>
</section>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
