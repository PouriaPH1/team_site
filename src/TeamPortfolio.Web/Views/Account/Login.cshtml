@model TeamPortfolio.Web.ViewModels.Account.LoginViewModel
@{
    ViewData["Title"] = "ورود مدیران";
    var returnUrl = ViewData["ReturnUrl"] as string;
}

@section Head {
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
}

<div class="auth-page">
  <div class="auth-card">

    <!-- ── Header ───────────────────────────────────────────── -->
    <div class="auth-header">
      <div class="auth-icon" aria-hidden="true">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none"
             xmlns="http://www.w3.org/2000/svg">
          <path d="M12 2C9.24 2 7 4.24 7 7C7 9.76 9.24 12 12 12C14.76 12 17 9.76 17 7C17 4.24 14.76 2 12 2Z"
                fill="currentColor" opacity="0.85"/>
          <path d="M12 14C7.33 14 3 16.33 3 19V21H21V19C21 16.33 16.67 14 12 14Z"
                fill="currentColor" opacity="0.55"/>
        </svg>
      </div>
      <h1 class="auth-title"><span class="text-gradient">ورود</span></h1>
      <p class="auth-subtitle">پنل مدیریت TeamPortfolio</p>
    </div>

    <!-- ── Alerts ────────────────────────────────────────────── -->
    @if (TempData["Success"] != null)
    {
      <div class="auth-alert success" role="alert">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true" style="flex-shrink:0;margin-top:1px">
          <path d="M20 6L9 17L4 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span>@TempData["Success"]</span>
      </div>
    }
    @if (TempData["Error"] != null)
    {
      <div class="auth-alert error" role="alert">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true" style="flex-shrink:0;margin-top:1px">
          <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/>
          <path d="M12 8v4M12 16h.01" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
        <span>@TempData["Error"]</span>
      </div>
    }

    <!-- ── Form ──────────────────────────────────────────────── -->
    <form asp-action="Login" asp-route-returnUrl="@returnUrl" method="post" novalidate>
      @Html.AntiForgeryToken()

      @{
        var validationSummary = Html.ValidationSummary(true, "", new { @class = "auth-alert error" });
        var vHtml = validationSummary.ToString();
        if (vHtml.Contains("<li>"))
        {
            @Html.ValidationSummary(true, "", new { @class = "auth-alert error" })
        }
      }

      <!-- Email -->
      <div class="auth-field">
        <label asp-for="Email">ایمیل</label>
        <div class="auth-input-wrap">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none"
               xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <rect x="2" y="4" width="20" height="16" rx="3" stroke="currentColor" stroke-width="1.8"/>
            <path d="M2 8L12 13L22 8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
          </svg>
          <input asp-for="Email"
                 class="auth-input"
                 type="email"
                 placeholder="admin@example.com"
                 autocomplete="email"
                 aria-describedby="email-error" />
        </div>
        <span asp-validation-for="Email" class="field-error" id="email-error"></span>
      </div>

      <!-- Password -->
      <div class="auth-field">
        <label asp-for="Password">رمز عبور</label>
        <div class="auth-input-wrap">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none"
               xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <rect x="5" y="11" width="14" height="10" rx="2" stroke="currentColor" stroke-width="1.8"/>
            <path d="M8 11V7a4 4 0 0 1 8 0v4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            <circle cx="12" cy="16" r="1.5" fill="currentColor"/>
          </svg>
          <input asp-for="Password"
                 class="auth-input has-toggle"
                 type="password"
                 placeholder="••••••••"
                 autocomplete="current-password"
                 id="password-input"
                 aria-describedby="password-error" />
          <button type="button"
                  class="auth-pwd-toggle"
                  id="pwd-toggle"
                  aria-label="نمایش/پنهان رمز عبور">
            <svg id="eye-icon" width="18" height="18" viewBox="0 0 24 24" fill="none"
                 xmlns="http://www.w3.org/2000/svg">
              <path d="M1 12C1 12 5 4 12 4C19 4 23 12 23 12C23 12 19 20 12 20C5 20 1 12 1 12Z"
                    stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
              <circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.8"/>
            </svg>
          </button>
        </div>
        <span asp-validation-for="Password" class="field-error" id="password-error"></span>
      </div>

      <!-- Remember + Forgot -->
      <div class="auth-options">
        <label class="auth-remember">
          <input asp-for="RememberMe" type="checkbox" />
          <span>مرا به خاطر بسپار</span>
        </label>
        <a asp-action="ForgotPassword" class="auth-forgot">فراموشی رمز؟</a>
      </div>

      <!-- Submit -->
      <button type="submit" class="auth-submit">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none"
             xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M15 3H19C20.1 3 21 3.9 21 5V19C21 20.1 20.1 21 19 21H15"
                stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          <path d="M10 17L15 12L10 7" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round"/>
          <line x1="15" y1="12" x2="3" y2="12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
        ورود به پنل
      </button>
    </form>

    <div class="auth-divider">
      دسترسی فقط برای مدیران مجاز
    </div>

  </div>
</div>

@section Scripts {
  @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
  <script>
    (function () {
      const btn = document.getElementById('pwd-toggle');
      const inp = document.getElementById('password-input');
      const icon = document.getElementById('eye-icon');
      if (!btn || !inp) return;
      btn.addEventListener('click', function () {
        const show = inp.type === 'password';
        inp.type = show ? 'text' : 'password';
        btn.setAttribute('aria-label', show ? 'پنهان کردن رمز عبور' : 'نمایش رمز عبور');
        icon.innerHTML = show
          ? '<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20C5 20 1 12 1 12A18.45 18.45 0 0 1 5.06 5.06M9.9 4.24A9.12 9.12 0 0 1 12 4C19 4 23 12 23 12A18.5 18.5 0 0 1 20.1 16.18M1 1L23 23" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.8"/>'
          : '<path d="M1 12C1 12 5 4 12 4C19 4 23 12 23 12C23 12 19 20 12 20C5 20 1 12 1 12Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.8"/>';
      });
    })();
  </script>
}
