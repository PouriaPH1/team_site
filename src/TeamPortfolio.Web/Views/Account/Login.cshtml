@model TeamPortfolio.Web.ViewModels.Account.LoginViewModel
@{
    ViewData["Title"] = "ورود";
    var returnUrl = ViewData["ReturnUrl"] as string;
}

<div class="auth-page">
  <div class="auth-card">
    <div class="auth-header">
      <h1 class="auth-title"><span class="text-gradient">ورود</span></h1>
      <p class="auth-subtitle">به پنل مدیریت خوش آمدید</p>
    </div>

    @if (TempData["Success"] != null)
    {
      <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
      <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <form asp-action="Login" asp-route-returnUrl="@returnUrl" method="post">
      @Html.AntiForgeryToken()
      <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

      <div class="form-group mb-4">
        <label asp-for="Email" class="form-label">ایمیل</label>
        <input asp-for="Email" class="form-control" type="email" placeholder="email@example.com" />
        <span asp-validation-for="Email" class="text-danger small"></span>
      </div>

      <div class="form-group mb-4">
        <label asp-for="Password" class="form-label">رمز عبور</label>
        <input asp-for="Password" class="form-control" type="password" />
        <span asp-validation-for="Password" class="text-danger small"></span>
      </div>

      <div class="form-check mb-4">
        <input asp-for="RememberMe" class="form-check-input" type="checkbox" />
        <label asp-for="RememberMe" class="form-check-label">مرا به خاطر بسپار (30 روز)</label>
      </div>

      <button type="submit" class="btn-primary w-100">ورود</button>
    </form>

    <p class="auth-footer"><a asp-action="ForgotPassword">رمز عبور را فراموش کردید؟</a></p>
  </div>
</div>

@section Scripts {
  @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
