@model TeamPortfolio.Web.ViewModels.Account.RegisterViewModel
@{
    ViewData["Title"] = "ثبت‌نام";
}

<div class="auth-page">
  <div class="auth-card">
    <div class="auth-header">
      <h1 class="auth-title"><span class="text-gradient">ثبت‌نام</span></h1>
      <p class="auth-subtitle">حساب کاربری جدید ایجاد کنید</p>
    </div>

    @if (TempData["Success"] != null)
    {
      <div class="alert alert-success">@TempData["Success"]</div>
    }

    <form asp-action="Register" method="post">
      @Html.AntiForgeryToken()
      <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

      <div class="form-group mb-4">
        <label asp-for="Email" class="form-label">ایمیل</label>
        <input asp-for="Email" class="form-control" type="email" placeholder="email@example.com" />
        <span asp-validation-for="Email" class="text-danger small"></span>
      </div>

      <div class="form-group mb-4">
        <label asp-for="Password" class="form-label">رمز عبور</label>
        <input asp-for="Password" class="form-control" type="password" placeholder="حداقل 8 کاراکتر" />
        <span asp-validation-for="Password" class="text-danger small"></span>
      </div>

      <div class="form-group mb-4">
        <label asp-for="ConfirmPassword" class="form-label">تکرار رمز عبور</label>
        <input asp-for="ConfirmPassword" class="form-control" type="password" />
        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
      </div>

      <button type="submit" class="btn-primary w-100">ثبت‌نام</button>
    </form>

    <p class="auth-footer">حساب دارید؟ <a asp-action="Login">وارد شوید</a></p>
  </div>
</div>

@section Scripts {
  @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
