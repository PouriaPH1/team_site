@model TeamPortfolio.Web.ViewModels.Account.ResetPasswordViewModel
@{
    ViewData["Title"] = "تغییر رمز عبور";
}

<div class="auth-page">
  <div class="auth-card">
    <div class="auth-header">
      <h1 class="auth-title"><span class="text-gradient">تغییر رمز عبور</span></h1>
      <p class="auth-subtitle">رمز عبور جدید خود را وارد کنید</p>
    </div>

    <form asp-action="ResetPassword" method="post">
      @Html.AntiForgeryToken()
      <input asp-for="Token" type="hidden" />
      <input asp-for="Email" type="hidden" />
      <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

      <div class="form-group mb-4">
        <label asp-for="Password" class="form-label">رمز عبور جدید</label>
        <input asp-for="Password" class="form-control" type="password" placeholder="حداقل 8 کاراکتر" />
        <span asp-validation-for="Password" class="text-danger small"></span>
      </div>

      <div class="form-group mb-4">
        <label asp-for="ConfirmPassword" class="form-label">تکرار رمز عبور جدید</label>
        <input asp-for="ConfirmPassword" class="form-control" type="password" />
        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
      </div>

      <button type="submit" class="btn-primary w-100">تغییر رمز عبور</button>
    </form>
  </div>
</div>

@section Scripts {
  @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
