@model TeamPortfolio.Web.ViewModels.Team.MemberProfileViewModel
@{
    ViewData["Title"] = Model.Member.FullName;
}

<!-- Profile Banner -->
<div style="background:linear-gradient(135deg,var(--color-surface) 0%,var(--color-surface-raised) 100%);border-bottom:1px solid var(--color-border);padding:3rem 0 0;">
    <div class="container-main">
        <div class="d-flex align-items-end gap-4 flex-wrap pb-4">
            @if (!string.IsNullOrEmpty(Model.Member.ProfilePhotoPath))
            {
                <img src="@Model.Member.ProfilePhotoPath" alt="@Model.Member.FullName"
                     style="width:120px;height:120px;border-radius:50%;object-fit:cover;border:4px solid var(--color-surface);box-shadow:var(--shadow-lg);flex-shrink:0;"
                     loading="lazy" />
            }
            else
            {
                <div style="width:120px;height:120px;border-radius:50%;background:var(--gradient-primary);display:flex;align-items:center;justify-content:center;font-size:2.5rem;color:white;font-weight:700;border:4px solid var(--color-surface);box-shadow:var(--shadow-lg);flex-shrink:0;">
                    @Model.Member.FirstName[0]@Model.Member.LastName[0]
                </div>
            }
            <div style="flex:1;min-width:200px;">
                <h1 style="font-size:clamp(1.5rem,3vw,2.25rem);margin-bottom:0.5rem;">@Model.Member.FullName</h1>
                <span class="badge badge-primary">@Model.Member.Role</span>
            </div>
        </div>
    </div>
</div>

<!-- Profile Content -->
<section class="section-wrapper">
    <div class="container-main">
        <div class="row g-5">

            <!-- Main column -->
            <div class="col-lg-8">
                @if (!string.IsNullOrEmpty(Model.Member.Biography))
                {
                    <div class="card mb-4" style="cursor:default;">
                        <h2 style="font-size:1.25rem;margin-bottom:1rem;">
                            <i class="fa-solid fa-user me-2" style="color:var(--color-primary);" aria-hidden="true"></i>Biography
                        </h2>
                        <p style="color:var(--color-text-secondary);line-height:1.8;">@Model.Member.Biography</p>
                    </div>
                }

                <!-- Skills placeholder -->
                <div class="card mb-4" style="cursor:default;">
                    <h2 style="font-size:1.25rem;margin-bottom:1.25rem;">
                        <i class="fa-solid fa-chart-bar me-2" style="color:var(--color-primary);" aria-hidden="true"></i>Skills
                    </h2>
                    <p style="color:var(--color-text-muted);font-size:0.9rem;">
                        <i class="fa-solid fa-info-circle me-1" aria-hidden="true"></i>No skills listed yet.
                    </p>
                </div>

                <!-- Work Experience placeholder -->
                <div class="card mb-4" style="cursor:default;">
                    <h2 style="font-size:1.25rem;margin-bottom:1.25rem;">
                        <i class="fa-solid fa-briefcase me-2" style="color:var(--color-primary);" aria-hidden="true"></i>Work Experience
                    </h2>
                    <p style="color:var(--color-text-muted);font-size:0.9rem;">
                        <i class="fa-solid fa-info-circle me-1" aria-hidden="true"></i>No work experience listed yet.
                    </p>
                </div>

                <!-- Education placeholder -->
                <div class="card" style="cursor:default;">
                    <h2 style="font-size:1.25rem;margin-bottom:1.25rem;">
                        <i class="fa-solid fa-graduation-cap me-2" style="color:var(--color-primary);" aria-hidden="true"></i>Education
                    </h2>
                    <p style="color:var(--color-text-muted);font-size:0.9rem;">
                        <i class="fa-solid fa-info-circle me-1" aria-hidden="true"></i>No education history listed yet.
                    </p>
                </div>
            </div>

            <!-- Sidebar -->
            <div class="col-lg-4">
                <div class="card" style="cursor:default;position:sticky;top:80px;">
                    <h3 style="font-size:1rem;font-weight:600;margin-bottom:1.25rem;color:var(--color-text-muted);text-transform:uppercase;letter-spacing:0.05em;">Connect</h3>
                    <div style="display:flex;flex-direction:column;gap:10px;">
                        <a href="mailto:@Model.Member.Role" class="btn-ghost" style="justify-content:flex-start;cursor:pointer;">
                            <i class="fa-solid fa-envelope fa-fw" aria-hidden="true"></i> Email
                        </a>
                        <a href="#" class="btn-ghost" style="justify-content:flex-start;cursor:pointer;">
                            <i class="fa-brands fa-github fa-fw" aria-hidden="true"></i> GitHub
                        </a>
                        <a href="#" class="btn-ghost" style="justify-content:flex-start;cursor:pointer;">
                            <i class="fa-brands fa-linkedin fa-fw" aria-hidden="true"></i> LinkedIn
                        </a>
                        <a href="#" class="btn-ghost" style="justify-content:flex-start;cursor:pointer;">
                            <i class="fa-brands fa-telegram fa-fw" aria-hidden="true"></i> Telegram
                        </a>
                    </div>
                    <hr style="border-color:var(--color-border);margin:1.25rem 0;">
                    <a asp-controller="Team" asp-action="Index" class="btn-secondary w-100" style="cursor:pointer;justify-content:center;">
                        <i class="fa-solid fa-arrow-left fa-fw" aria-hidden="true"></i> Back to Team
                    </a>
                </div>
            </div>

        </div>
    </div>
</section>
