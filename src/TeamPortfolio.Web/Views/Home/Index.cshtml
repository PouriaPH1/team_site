@model TeamPortfolio.Web.ViewModels.Home.HomeViewModel
@{
    ViewData["Title"] = "Home";
    ViewData["HideBreadcrumb"] = true;
}

@* ═══ Starry Night Hero Section ══════════════════════════════ *@
@await Html.PartialAsync("_HeroSection")

@* ═══ Terminal Team Explorer (below hero) ═══════════════════ *@
@await Html.PartialAsync("_TerminalSection")

@* ═══ Projects, Blog sections below ══════════════════════════ *@

<!-- ═══════════════════════════════════════════ PROJECTS ═══ -->
<section class="section-wrapper">
    <div class="container-main">
        <div class="text-center mb-5">
            <p class="section-eyebrow" data-reveal><i class="fa-solid fa-folder-open me-2" aria-hidden="true"></i>Our Work</p>
            <h2 class="section-title" data-reveal data-reveal-delay="1">Latest Projects</h2>
            <p class="section-subtitle" data-reveal data-reveal-delay="2">A selection of our most recent work across web, API, and cloud platforms.</p>
        </div>

        @if (Model.LatestProjects.Any())
        {
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4" data-reveal-group>
                @{ int projectIdx = 0; }
                @foreach (var project in Model.LatestProjects)
                {
                    var delayAttr = (projectIdx % 4) + 1;
                    <div class="col" data-reveal data-reveal-scale data-reveal-delay="@delayAttr">
                        <a href="/Portfolio/@project.Slug" class="card d-block text-decoration-none" style="height:100%;">
                            @if (!string.IsNullOrEmpty(project.CoverImagePath))
                            {
                                <img src="@project.CoverImagePath" alt="@project.Title"
                                     style="width:100%;height:180px;object-fit:cover;border-radius:var(--radius-md);margin-bottom:1rem;"
                                     loading="lazy" />
                            }
                            else
                            {
                                <div style="width:100%;height:180px;background:var(--color-surface-raised);border-radius:var(--radius-md);margin-bottom:1rem;display:flex;align-items:center;justify-content:center;">
                                    <i class="fa-solid fa-image" style="font-size:2rem;color:var(--color-text-muted);" aria-hidden="true"></i>
                                </div>
                            }
                            <h3 style="font-size:1.1rem;margin-bottom:0.5rem;">@project.Title</h3>
                            <p style="color:var(--color-text-secondary);font-size:0.875rem;margin-bottom:1rem;line-height:1.6;">
                                @(project.Description.Length > 100 ? project.Description[..100] + "…" : project.Description)
                            </p>
                            <div style="display:flex;flex-wrap:wrap;gap:6px;">
                                @foreach (var tech in project.Technologies.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Take(4))
                                {
                                    <span class="badge badge-primary">@tech</span>
                                }
                            </div>
                        </a>
                    </div>
                    projectIdx++;
                }
            </div>
            <div class="text-center mt-5">
                <a href="/Portfolio" class="btn-secondary" data-reveal>
                    <i class="fa-solid fa-arrow-right" aria-hidden="true"></i> View All Projects
                </a>
            </div>
        }
        else
        {
            <div class="text-center" style="padding:4rem;color:var(--color-text-muted);">
                <i class="fa-solid fa-folder-open" style="font-size:3rem;margin-bottom:1rem;display:block;" aria-hidden="true"></i>
                <p>Projects coming soon.</p>
            </div>
        }
    </div>
</section>

<!-- ═══════════════════════════════════════════ SKILLS / TECH STACK ═══ -->
@await Html.PartialAsync("_SkillsSection")

<!-- ═══════════════════════════════════════════ BLOG ═══ -->
<section class="section-wrapper">
    <div class="container-main">
        <div class="text-center mb-5">
            <p class="section-eyebrow" data-reveal><i class="fa-solid fa-newspaper me-2" aria-hidden="true"></i>Knowledge Base</p>
            <h2 class="section-title" data-reveal data-reveal-delay="1">Latest Blog Posts</h2>
            <p class="section-subtitle" data-reveal data-reveal-delay="2">Technical articles, tutorials, and insights from our team.</p>
        </div>

        @if (Model.LatestPosts.Any())
        {
            <div class="row row-cols-1 row-cols-md-3 g-4" data-reveal-group>
                @{ int postIdx = 0; }
                @foreach (var post in Model.LatestPosts)
                {
                    var postDelay = (postIdx % 3) + 1;
                    <div class="col" data-reveal data-reveal-scale data-reveal-delay="@postDelay">
                        <a href="/Blog/@post.Slug" class="card d-block text-decoration-none" style="height:100%;">
                            @if (!string.IsNullOrEmpty(post.CoverImagePath))
                            {
                                <img src="@post.CoverImagePath" alt="@post.Title"
                                     style="width:100%;height:160px;object-fit:cover;border-radius:var(--radius-md);margin-bottom:1rem;"
                                     loading="lazy" />
                            }
                            <span class="badge badge-primary mb-2">@post.CategoryName</span>
                            <h3 style="font-size:1.05rem;margin-bottom:0.5rem;">@post.Title</h3>
                            <p style="color:var(--color-text-secondary);font-size:0.875rem;line-height:1.6;flex:1;">
                                @(post.Body.Length > 120 ? System.Text.RegularExpressions.Regex.Replace(post.Body, "<[^>]+>", "")[..Math.Min(120, post.Body.Length)] + "…" : post.Body)
                            </p>
                            <div style="margin-top:1rem;padding-top:1rem;border-top:1px solid var(--color-border);display:flex;justify-content:space-between;align-items:center;">
                                <span style="font-size:0.8rem;color:var(--color-text-muted);">
                                    <i class="fa-solid fa-user fa-fw" aria-hidden="true"></i> @post.AuthorName
                                </span>
                                <span style="font-size:0.8rem;color:var(--color-text-muted);">
                                    <i class="fa-solid fa-eye fa-fw" aria-hidden="true"></i> @post.ViewCount
                                </span>
                            </div>
                        </a>
                    </div>
                    postIdx++;
                }
            </div>
            <div class="text-center mt-5">
                <a href="/Blog" class="btn-secondary" data-reveal>
                    <i class="fa-solid fa-arrow-right" aria-hidden="true"></i> Read All Posts
                </a>
            </div>
        }
        else
        {
            <div class="text-center" style="padding:4rem;color:var(--color-text-muted);">
                <i class="fa-solid fa-newspaper" style="font-size:3rem;margin-bottom:1rem;display:block;" aria-hidden="true"></i>
                <p>Blog posts coming soon.</p>
            </div>
        }
    </div>
</section>

<!-- ═══════════════════════════════════════════ TESTIMONIALS ═══ -->
<section class="section-wrapper">
    <div class="container-main">
        <div class="text-center mb-5">
            <p class="section-eyebrow" data-reveal><i class="fa-solid fa-star me-2" aria-hidden="true"></i>Client Reviews</p>
            <h2 class="section-title" data-reveal data-reveal-delay="1">What People Say</h2>
        </div>
        <div class="row row-cols-1 row-cols-md-3 g-4" data-reveal-group>
            <div class="col" data-reveal data-reveal-from="left" data-reveal-delay="1">
                <div class="card" style="border-left:4px solid var(--color-primary);cursor:default;">
                    <i class="fa-solid fa-quote-left" style="font-size:1.5rem;color:var(--color-primary);margin-bottom:1rem;" aria-hidden="true"></i>
                    <p style="color:var(--color-text-secondary);line-height:1.7;margin-bottom:1.25rem;">
                        "Outstanding quality and professionalism. The team delivered a scalable solution that exceeded our expectations."
                    </p>
                    <div style="display:flex;align-items:center;gap:12px;">
                        <div style="width:40px;height:40px;border-radius:50%;background:var(--gradient-primary);display:flex;align-items:center;justify-content:center;color:white;font-weight:700;font-size:0.875rem;">AK</div>
                        <div>
                            <div style="font-weight:600;font-size:0.9rem;">Alex Kim</div>
                            <div style="font-size:0.8rem;color:var(--color-text-muted);">CTO, TechCorp</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col" data-reveal data-reveal-scale data-reveal-delay="2">
                <div class="card" style="border-left:4px solid var(--color-accent);cursor:default;">
                    <i class="fa-solid fa-quote-left" style="font-size:1.5rem;color:var(--color-accent);margin-bottom:1rem;" aria-hidden="true"></i>
                    <p style="color:var(--color-text-secondary);line-height:1.7;margin-bottom:1.25rem;">
                        "Fast, reliable, and communicative. They built our entire API platform in record time with clean, maintainable code."
                    </p>
                    <div style="display:flex;align-items:center;gap:12px;">
                        <div style="width:40px;height:40px;border-radius:50%;background:var(--gradient-primary);display:flex;align-items:center;justify-content:center;color:white;font-weight:700;font-size:0.875rem;">SM</div>
                        <div>
                            <div style="font-weight:600;font-size:0.9rem;">Sara Moradi</div>
                            <div style="font-size:0.8rem;color:var(--color-text-muted);">Product Manager, StartupX</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col" data-reveal data-reveal-from="right" data-reveal-delay="3">
                <div class="card" style="border-left:4px solid var(--color-success);cursor:default;">
                    <i class="fa-solid fa-quote-left" style="font-size:1.5rem;color:var(--color-success);margin-bottom:1rem;" aria-hidden="true"></i>
                    <p style="color:var(--color-text-secondary);line-height:1.7;margin-bottom:1.25rem;">
                        "The best engineering team we've worked with. Deep technical expertise combined with a strong sense of ownership."
                    </p>
                    <div style="display:flex;align-items:center;gap:12px;">
                        <div style="width:40px;height:40px;border-radius:50%;background:var(--gradient-primary);display:flex;align-items:center;justify-content:center;color:white;font-weight:700;font-size:0.875rem;">MR</div>
                        <div>
                            <div style="font-weight:600;font-size:0.9rem;">Mike Ramirez</div>
                            <div style="font-size:0.8rem;color:var(--color-text-muted);">CEO, BuildFast</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ═══════════════════════════════════════════ CONTACT CTA ═══ -->
<section class="section-wrapper text-center">
    <div class="container-main">
        <p class="section-eyebrow" data-reveal><i class="fa-solid fa-envelope me-2" aria-hidden="true"></i>Get In Touch</p>
        <h2 class="section-title" data-reveal data-reveal-delay="1">Ready to Work Together?</h2>
        <p class="section-subtitle mb-5" data-reveal data-reveal-delay="2">Have a project in mind? We'd love to hear about it. Send us a message and we'll get back to you.</p>
        <a href="/Contact" class="btn-primary" data-reveal data-reveal-delay="3" style="font-size:1rem;padding:14px 32px;">
            <i class="fa-solid fa-paper-plane" aria-hidden="true"></i> Start a Conversation
        </a>
    </div>
</section>


