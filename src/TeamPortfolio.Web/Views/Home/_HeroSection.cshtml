@*
    _HeroSection.cshtml — Van Gogh Hero (Phase 1)
    Code block moved inside hero-left to prevent overlap at 100% zoom.
*@
@{
    ViewData["HideBreadcrumb"] = true;
}

<section id="hero-section" aria-labelledby="hero-heading">

    <!-- Layer 0: Background Image -->
    <div class="hero-bg" aria-hidden="true"></div>

    <!-- Layer 1: Gradient Overlays -->
    <div class="hero-overlay" aria-hidden="true"></div>
    <div class="hero-overlay-bottom" aria-hidden="true"></div>

    <!-- Layer 10: HTML Content -->
    <div class="hero-wrapper">

        <!-- LEFT: all text content + code block stacked vertically -->
        <div class="hero-left">

            <p class="hero-eyebrow" data-reveal>WE ARE</p>

            <div class="hero-headline-block" data-reveal>
                <div id="hero-heading" class="hero-line-main">Code. Design.</div>
                <div class="hero-line-create" aria-label="Create.">Create.</div>
            </div>

            <p class="hero-subtitle"
               data-reveal
               data-typewriter="We're a team of passionate developers and designers building beautiful digital experiences.">
            </p>

            <div class="hero-cta-row" data-reveal>
                <a asp-area="" asp-controller="Portfolio" asp-action="Index"
                   class="hero-cta-primary">
                    Explore Our Work
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2"
                              stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </a>
                <a asp-area="" asp-controller="Team" asp-action="Index"
                   class="hero-cta-secondary">
                    Meet the Team
                </a>
            </div>

            <!-- Hero Stats Row -->
            <div class="hero-stats-row" data-reveal>
                <div class="hero-stat">
                    <span class="hero-stat-num">+48</span>
                    <span class="hero-stat-label">Projects Delivered</span>
                </div>
                <div class="hero-stat-divider"></div>
                <div class="hero-stat">
                    <span class="hero-stat-num">99%</span>
                    <span class="hero-stat-label">Client Satisfaction</span>
                </div>
                <div class="hero-stat-divider"></div>
                <div class="hero-stat">
                    <span class="hero-stat-num">24/7</span>
                    <span class="hero-stat-label">Support &amp; Development</span>
                </div>
            </div>

            <!-- Code block — inside hero-left, below CTA, never overlaps -->
            <div class="hero-code-block" data-reveal>
                <div class="hero-code-inner">

                    <!-- Titlebar -->
                    <div class="hero-code-titlebar">
                        <div class="hero-code-dots">
                            <span class="dot dot-red"   aria-hidden="true"></span>
                            <span class="dot dot-yellow" aria-hidden="true"></span>
                            <span class="dot dot-green"  aria-hidden="true"></span>
                            <span class="hero-code-filename">starry_create.js</span>
                        </div>
                        <div class="hero-code-actions">
                            <button class="hero-code-copy" title="Copy code" aria-label="Copy code">
                                <!-- Copy icon -->
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                    <rect x="9" y="9" width="13" height="13" rx="2" stroke="currentColor" stroke-width="1.8" fill="none"/>
                                    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" stroke="currentColor" stroke-width="1.8" fill="none"/>
                                </svg>
                            </button>
                            <button class="hero-code-run" aria-label="Run code">
                                <!-- Play icon -->
                                <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                    <path d="M5 3l14 9-14 9V3z"/>
                                </svg>
                                Run
                            </button>
                        </div>
                    </div>

                    <!-- Code content -->
                    <pre class="hero-code-snippet" aria-label="Poetic code snippet"><code><span class="code-line-num">01</span>  <span class="code-keyword">const</span> <span class="code-variable">create</span> = () => {
<span class="code-line-num">02</span>    <span class="code-keyword">let</span> <span class="code-variable">ideas</span> = <span class="code-string">'limitless'</span>;
<span class="code-line-num">03</span>    <span class="code-keyword">let</span> <span class="code-variable">passion</span> = <span class="code-keyword">true</span>;
<span class="code-line-num">04</span>    <span class="code-keyword">while</span> (<span class="code-variable">passion</span>) {
<span class="code-line-num">05</span>      <span class="code-function">code</span>();
<span class="code-line-num">06</span>      <span class="code-function">design</span>();
<span class="code-line-num">07</span>    }
<span class="code-line-num">08</span>  }</code></pre>

                    <!-- Output panel (hidden by default) -->
                    <div class="hero-code-output" aria-live="polite" hidden>
                        <span class="output-line"></span>
                    </div>

                </div>
            </div>

        </div><!-- /.hero-left -->

        <!-- RIGHT: comments + constellation -->
        <div class="hero-right" aria-hidden="true" data-reveal>

            <div class="hero-comments-right">
                <p>// The best code</p>
                <p>// is written with</p>
                <p>// passion.</p>
            </div>

            <svg class="hero-constellation-right"
                 width="140" height="110" viewBox="0 0 140 110"
                 xmlns="http://www.w3.org/2000/svg"
                 aria-hidden="true" focusable="false">
                <line x1="25" y1="25" x2="80" y2="48" stroke="rgba(74,155,181,0.40)" stroke-width="1.2"/>
                <line x1="80" y1="48" x2="115" y2="22" stroke="rgba(74,155,181,0.40)" stroke-width="1.2"/>
                <line x1="80" y1="48" x2="70"  y2="88" stroke="rgba(74,155,181,0.30)" stroke-width="1"/>
                <line x1="25" y1="25" x2="70"  y2="88" stroke="rgba(74,155,181,0.25)" stroke-width="1"/>
                <line x1="115" y1="22" x2="70" y2="88" stroke="rgba(74,155,181,0.20)" stroke-width="0.8"/>
                <circle cx="25" cy="25" r="3.5" fill="rgba(74,155,181,0.85)">
                    <animate attributeName="opacity" values="0.5;1;0.5" dur="3s" repeatCount="indefinite"/>
                    <animate attributeName="r" values="3;4;3" dur="3s" repeatCount="indefinite"/>
                </circle>
                <circle cx="80" cy="48" r="5" fill="rgba(245,200,66,0.90)">
                    <animate attributeName="opacity" values="0.65;1;0.65" dur="4s" repeatCount="indefinite"/>
                    <animate attributeName="r" values="4.5;6;4.5" dur="4s" repeatCount="indefinite"/>
                </circle>
                <circle cx="115" cy="22" r="3" fill="rgba(74,155,181,0.75)">
                    <animate attributeName="opacity" values="0.4;0.9;0.4" dur="2.5s" repeatCount="indefinite"/>
                </circle>
                <circle cx="70" cy="88" r="3.5" fill="rgba(248,244,232,0.70)">
                    <animate attributeName="opacity" values="0.35;0.85;0.35" dur="3.5s" repeatCount="indefinite"/>
                </circle>
                <circle cx="80" cy="48" r="10" fill="rgba(245,200,66,0.08)">
                    <animate attributeName="r" values="8;14;8" dur="4s" repeatCount="indefinite"/>
                    <animate attributeName="opacity" values="0.12;0.04;0.12" dur="4s" repeatCount="indefinite"/>
                </circle>
            </svg>

        </div><!-- /.hero-right -->

    </div><!-- /.hero-wrapper -->

    <!-- Scroll Indicator — bottom center -->
    <div class="hero-scroll-indicator" aria-hidden="true" tabindex="-1">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
             xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
            <rect x="9" y="3" width="6" height="11" rx="3" stroke="currentColor" stroke-width="1.5" fill="none"/>
            <circle cx="12" cy="7" r="1.5" fill="currentColor"/>
        </svg>
        <span>SCROLL DOWN</span>
    </div>

</section>
