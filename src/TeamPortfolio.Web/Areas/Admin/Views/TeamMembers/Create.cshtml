@model TeamPortfolio.Web.ViewModels.Admin.TeamMemberFormViewModel
@{ ViewData["Title"] = "Add Member"; }

<div class="d-flex align-items-center gap-3 mb-4">
    <a asp-action="Index" class="btn-ghost" style="cursor:pointer;" aria-label="Back to list">
        <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
    </a>
    <h1 style="font-size:1.5rem;margin:0;">Add Team Member</h1>
</div>

<div class="card" style="cursor:default;max-width:640px;">
    <form asp-action="Create" method="post" enctype="multipart/form-data" novalidate>
        @Html.AntiForgeryToken()

        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label asp-for="FirstName" class="form-label"
                       style="font-size:0.875rem;color:var(--color-text-secondary);">First Name *</label>
                <input asp-for="FirstName" class="form-control" placeholder="e.g. John" autocomplete="given-name" />
                <span asp-validation-for="FirstName" style="color:var(--color-danger);font-size:0.8rem;"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="LastName" class="form-label"
                       style="font-size:0.875rem;color:var(--color-text-secondary);">Last Name *</label>
                <input asp-for="LastName" class="form-control" placeholder="e.g. Doe" autocomplete="family-name" />
                <span asp-validation-for="LastName" style="color:var(--color-danger);font-size:0.8rem;"></span>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="Role" class="form-label"
                   style="font-size:0.875rem;color:var(--color-text-secondary);">Role *</label>
            <input asp-for="Role" class="form-control" placeholder="e.g. Senior Developer" />
            <span asp-validation-for="Role" style="color:var(--color-danger);font-size:0.8rem;"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Biography" class="form-label"
                   style="font-size:0.875rem;color:var(--color-text-secondary);">Biography</label>
            <textarea asp-for="Biography" class="form-control" rows="4"
                      placeholder="Short bio for the public profile..."></textarea>
        </div>

        <div class="mb-3">
            <label asp-for="ProfilePhoto" class="form-label"
                   style="font-size:0.875rem;color:var(--color-text-secondary);">
                Profile Photo <span style="color:var(--color-text-muted);font-weight:400;">(JPEG / PNG / WebP, max 5 MB)</span>
            </label>
            <input asp-for="ProfilePhoto" type="file" class="form-control" accept="image/jpeg,image/png,image/webp" />
            <span asp-validation-for="ProfilePhoto" style="color:var(--color-danger);font-size:0.8rem;"></span>
        </div>

        <div class="mb-4">
            <div style="display:flex;align-items:center;gap:10px;">
                <input asp-for="IsActive" type="checkbox" style="width:18px;height:18px;cursor:pointer;" />
                <label asp-for="IsActive" style="font-size:0.9rem;cursor:pointer;margin:0;">
                    Active <span style="color:var(--color-text-muted);font-size:0.8rem;">(visible on site)</span>
                </label>
            </div>
        </div>

        <div style="display:flex;gap:12px;flex-wrap:wrap;">
            <button type="submit" class="btn-primary" style="cursor:pointer;">
                <i class="fa-solid fa-plus" aria-hidden="true"></i> Create Member
            </button>
            <a asp-action="Index" class="btn-secondary" style="cursor:pointer;">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
