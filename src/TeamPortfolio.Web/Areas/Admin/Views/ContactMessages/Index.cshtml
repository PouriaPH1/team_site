@model IEnumerable<TeamPortfolio.Domain.Entities.ContactMessage>
@{ ViewData["Title"] = "Contact Messages"; }

<div class="d-flex align-items-center justify-content-between mb-4">
    <h1 style="font-size:1.5rem;margin:0;">Contact Messages</h1>
    <span class="badge badge-primary">@Model.Count(m => !m.IsRead) unread</span>
</div>

@if (TempData["Success"] != null)
{ <div class="card mb-3" style="border-left:4px solid var(--color-success);cursor:default;"><p style="margin:0;color:var(--color-success);"><i class="fa-solid fa-circle-check me-2" aria-hidden="true"></i>@TempData["Success"]</p></div> }

@if (!Model.Any())
{
    <div class="card text-center" style="cursor:default;padding:3rem;">
        <i class="fa-solid fa-envelope-open" style="font-size:2.5rem;color:var(--color-text-muted);display:block;margin-bottom:1rem;" aria-hidden="true"></i>
        <p style="color:var(--color-text-muted);">No messages yet.</p>
    </div>
}
else
{
    <div style="display:flex;flex-direction:column;gap:12px;">
        @foreach (var msg in Model)
        {
            <div class="card" style="cursor:default;@(!msg.IsRead ? "border-left:3px solid var(--color-primary);" : "")">
                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-2">
                    <div>
                        @if (!msg.IsRead) { <span class="badge badge-primary me-2" style="font-size:0.7rem;">NEW</span> }
                        <strong>@msg.FullName</strong>
                        <span style="font-size:0.8rem;color:var(--color-text-muted);margin-left:8px;"><i class="fa-solid fa-envelope fa-fw" aria-hidden="true"></i> @msg.Email</span>
                    </div>
                    <span style="font-size:0.8rem;color:var(--color-text-muted);">@msg.CreatedAt.ToString("MMM dd, yyyy")</span>
                </div>
                <div style="font-weight:600;margin-bottom:0.5rem;">@msg.Subject</div>
                <p style="color:var(--color-text-secondary);font-size:0.9rem;line-height:1.6;margin-bottom:1.25rem;">@msg.Body</p>
                <div style="display:flex;gap:10px;flex-wrap:wrap;">
                    @if (!msg.IsRead)
                    {
                        <form asp-action="MarkRead" asp-route-id="@msg.Id" method="post" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn-ghost" style="cursor:pointer;"><i class="fa-solid fa-envelope-open fa-fw" aria-hidden="true"></i> Mark Read</button>
                        </form>
                    }
                    <button class="btn-ghost" onclick="confirmDelMsg(@msg.Id)" style="cursor:pointer;color:var(--color-danger);" aria-label="Delete message"><i class="fa-solid fa-trash fa-fw" aria-hidden="true"></i> Delete</button>
                    <form id="del-msg-@msg.Id" asp-action="Delete" asp-route-id="@msg.Id" method="post" style="display:none;">@Html.AntiForgeryToken()</form>
                </div>
            </div>
        }
    </div>
}

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js"></script>
<script>
function confirmDelMsg(id) {
    Swal.fire({ title:'Delete Message?', icon:'warning', showCancelButton:true, confirmButtonText:'Delete',
        confirmButtonColor:'var(--color-danger)', background:'var(--color-surface)', color:'var(--color-text)' })
    .then(r => { if(r.isConfirmed) document.getElementById('del-msg-'+id).submit(); });
}
</script>
}
