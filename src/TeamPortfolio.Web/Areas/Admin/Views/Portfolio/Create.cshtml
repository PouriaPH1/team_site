@model TeamPortfolio.Web.ViewModels.Admin.PortfolioFormViewModel
@{ ViewData["Title"] = "Add Project"; }

<div class="d-flex align-items-center gap-3 mb-4">
    <a asp-action="Index" class="btn-ghost" style="cursor:pointer;" aria-label="Back to list">
        <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
    </a>
    <h1 style="font-size:1.5rem;margin:0;">Add Project</h1>
</div>

<div class="card" style="cursor:default;max-width:720px;">
    <form asp-action="Create" method="post" enctype="multipart/form-data" novalidate>
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label asp-for="Title" class="form-label"
                   style="font-size:0.875rem;color:var(--color-text-secondary);">Title *</label>
            <input asp-for="Title" class="form-control" placeholder="e.g. E-Commerce Platform" />
            <span asp-validation-for="Title" style="color:var(--color-danger);font-size:0.8rem;"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label"
                   style="font-size:0.875rem;color:var(--color-text-secondary);">Description *</label>
            <textarea asp-for="Description" class="form-control" rows="4"
                      placeholder="Describe the project, goals, and outcomes..."></textarea>
            <span asp-validation-for="Description" style="color:var(--color-danger);font-size:0.8rem;"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Technologies" class="form-label"
                   style="font-size:0.875rem;color:var(--color-text-secondary);">Technologies *</label>
            <input asp-for="Technologies" class="form-control"
                   placeholder="e.g. ASP.NET Core, React, PostgreSQL (comma-separated)" />
            <span asp-validation-for="Technologies" style="color:var(--color-danger);font-size:0.8rem;"></span>
            <small style="color:var(--color-text-muted);">Separate technologies with commas.</small>
        </div>

        <div class="mb-3">
            <label asp-for="StartDate" class="form-label"
                   style="font-size:0.875rem;color:var(--color-text-secondary);">Start Date</label>
            <input asp-for="StartDate" type="date" class="form-control" />
        </div>

        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label asp-for="GitHubUrl" class="form-label"
                       style="font-size:0.875rem;color:var(--color-text-secondary);">GitHub URL</label>
                <div style="position:relative;">
                    <span style="position:absolute;left:12px;top:50%;transform:translateY(-50%);color:var(--color-text-muted);">
                        <i class="fa-brands fa-github" aria-hidden="true"></i>
                    </span>
                    <input asp-for="GitHubUrl" type="url" class="form-control"
                           style="padding-left:2.25rem;"
                           placeholder="https://github.com/..." />
                </div>
            </div>
            <div class="col-md-6">
                <label asp-for="DemoUrl" class="form-label"
                       style="font-size:0.875rem;color:var(--color-text-secondary);">Demo URL</label>
                <div style="position:relative;">
                    <span style="position:absolute;left:12px;top:50%;transform:translateY(-50%);color:var(--color-text-muted);">
                        <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
                    </span>
                    <input asp-for="DemoUrl" type="url" class="form-control"
                           style="padding-left:2.25rem;"
                           placeholder="https://demo.example.com" />
                </div>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="CoverImage" class="form-label"
                   style="font-size:0.875rem;color:var(--color-text-secondary);">
                Cover Image
                <span style="color:var(--color-text-muted);font-weight:400;">(JPEG / PNG / WebP, max 5 MB)</span>
            </label>
            <input asp-for="CoverImage" type="file" class="form-control"
                   accept="image/jpeg,image/png,image/webp" />
            <span asp-validation-for="CoverImage" style="color:var(--color-danger);font-size:0.8rem;"></span>
        </div>

        <div class="mb-4">
        </div>

        <div style="display:flex;gap:12px;flex-wrap:wrap;">
            <button type="submit" class="btn-primary" style="cursor:pointer;">
                <i class="fa-solid fa-plus" aria-hidden="true"></i> Create Project
            </button>
            <a asp-action="Index" class="btn-secondary" style="cursor:pointer;">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
