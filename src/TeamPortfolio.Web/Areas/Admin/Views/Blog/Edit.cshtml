@model TeamPortfolio.Web.ViewModels.Admin.BlogPostFormViewModel
@{ ViewData["Title"] = "Edit Post"; }

<div class="d-flex align-items-center gap-3 mb-4">
    <a asp-action="Index" class="btn-ghost" style="cursor:pointer;" aria-label="Back to list">
        <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
    </a>
    <h1 style="font-size:1.5rem;margin:0;">Edit Post</h1>
</div>

<div class="card" style="cursor:default;max-width:800px;">
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" novalidate>
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label asp-for="Title" class="form-label"
                   style="font-size:0.875rem;color:var(--color-text-secondary);">Title *</label>
            <input asp-for="Title" class="form-control" />
            <span asp-validation-for="Title" style="color:var(--color-danger);font-size:0.8rem;"></span>
        </div>

        <div class="mb-3">
            <label asp-for="CategoryName" class="form-label"
                   style="font-size:0.875rem;color:var(--color-text-secondary);">Category</label>
            <input asp-for="CategoryName" class="form-control"
                   placeholder="e.g. Technology, Design, Tutorial" />
        </div>

        <div class="mb-3">
            <label asp-for="Body" class="form-label"
                   style="font-size:0.875rem;color:var(--color-text-secondary);">Content *</label>
            <textarea asp-for="Body" class="form-control" rows="14"></textarea>
            <span asp-validation-for="Body" style="color:var(--color-danger);font-size:0.8rem;"></span>
        </div>

        <div class="mb-3">
            <label class="form-label" style="font-size:0.875rem;color:var(--color-text-secondary);">Cover Image</label>

            @if (!string.IsNullOrEmpty(Model.CoverImagePath))
            {
                <div style="margin-bottom:10px;display:flex;align-items:center;gap:12px;">
                    <img src="@Model.CoverImagePath" alt="Current cover image"
                         style="width:100px;height:60px;object-fit:cover;border-radius:var(--radius-sm);border:1px solid var(--color-border);" />
                    <div>
                        <p style="margin:0;font-size:0.8rem;color:var(--color-text-muted);">Current cover image</p>
                        <p style="margin:0;font-size:0.8rem;color:var(--color-text-muted);">Upload a new one to replace it.</p>
                    </div>
                </div>
            }

            <label asp-for="CoverImage" class="form-label"
                   style="font-size:0.875rem;color:var(--color-text-secondary);">
                @(string.IsNullOrEmpty(Model.CoverImagePath) ? "Upload image" : "Replace image")
                <span style="color:var(--color-text-muted);font-weight:400;">(JPEG / PNG / WebP, max 5 MB)</span>
            </label>
            <input asp-for="CoverImage" type="file" class="form-control"
                   accept="image/jpeg,image/png,image/webp" />
            <span asp-validation-for="CoverImage" style="color:var(--color-danger);font-size:0.8rem;"></span>
        </div>

        <div class="mb-4">
        </div>

        <div style="display:flex;gap:12px;flex-wrap:wrap;">
            <button type="submit" class="btn-primary" style="cursor:pointer;">
                <i class="fa-solid fa-floppy-disk" aria-hidden="true"></i> Update Post
            </button>
            <a asp-action="Index" class="btn-secondary" style="cursor:pointer;">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
