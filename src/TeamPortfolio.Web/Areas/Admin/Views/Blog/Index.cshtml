@model IEnumerable<TeamPortfolio.Application.DTOs.BlogPostDto>
@{ ViewData["Title"] = "Blog Posts"; }

<div class="d-flex align-items-center justify-content-between mb-4">
    <h1 style="font-size:1.5rem;margin:0;color:var(--color-moon-white);">Blog Posts</h1>
    <a asp-action="Create" class="btn-primary" style="cursor:pointer;">
        <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i> Write Post
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="card mb-4" style="border-left:4px solid var(--color-success);cursor:default;">
        <p style="margin:0;color:var(--color-success);">
            <i class="fa-solid fa-circle-check me-2" aria-hidden="true"></i>@TempData["Success"]
        </p>
    </div>
}

<div class="card" style="cursor:default;overflow-x:auto;">
    <table style="width:100%;border-collapse:collapse;font-size:0.9rem;">
        <thead>
            <tr style="border-bottom:1px solid var(--color-border);">
                <th style="padding:12px 16px;text-align:left;color:var(--color-parchment);font-weight:600;">Title</th>
                <th style="padding:12px 16px;text-align:left;color:var(--color-parchment);font-weight:600;">Author</th>
                <th style="padding:12px 16px;text-align:left;color:var(--color-parchment);font-weight:600;">Category</th>
                <th style="padding:12px 16px;text-align:right;color:var(--color-parchment);font-weight:600;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="4" style="padding:3rem;text-align:center;color:var(--color-text-muted);">
                        <i class="fa-solid fa-newspaper fa-2x mb-2 d-block" aria-hidden="true"></i>
                        No posts yet. <a asp-action="Create" style="color:var(--color-primary);">Write one</a>.
                    </td>
                </tr>
            }
            @foreach (var post in Model)
            {
                <tr style="border-bottom:1px solid var(--color-border);">
                    <td style="padding:12px 16px;font-weight:500;">@post.Title</td>
                    <td style="padding:12px 16px;color:var(--color-text-secondary);">@post.AuthorName</td>
                    <td style="padding:12px 16px;color:var(--color-text-secondary);">
                        @if (!string.IsNullOrEmpty(post.CategoryName))
                        {
                            <span class="badge badge-accent" style="font-size:0.75rem;">@post.CategoryName</span>
                        }
                        else
                        {
                            <span style="color:var(--color-text-muted);font-size:0.8rem;">—</span>
                        }
                    </td>
                    <td style="padding:12px 16px;text-align:right;">
                        <a asp-action="Edit" asp-route-id="@post.Id" class="btn-ghost"
                           style="cursor:pointer;margin-right:4px;" aria-label="Edit @post.Title">
                            <i class="fa-solid fa-pen fa-fw" aria-hidden="true"></i>
                        </a>
                        <button class="btn-ghost"
                                onclick="confirmDelete(@post.Id, '@Html.Raw(post.Title.Replace("'", "\\'"))')"
                                style="cursor:pointer;color:var(--color-danger);"
                                aria-label="Delete @post.Title">
                            <i class="fa-solid fa-trash fa-fw" aria-hidden="true"></i>
                        </button>
                        <form id="del-@post.Id" asp-action="Delete" asp-route-id="@post.Id"
                              method="post" style="display:none;">
                            @Html.AntiForgeryToken()
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js"></script>
    <script>
    function confirmDelete(id, name) {
        Swal.fire({
            title: 'Delete Post?',
            text: 'Delete "' + name + '"? This cannot be undone.',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Delete',
            cancelButtonText: 'Cancel',
            confirmButtonColor: 'var(--color-danger)',
            background: 'var(--color-surface)',
            color: 'var(--color-text)'
        }).then(r => { if (r.isConfirmed) document.getElementById('del-' + id).submit(); });
    }
    </script>
}
