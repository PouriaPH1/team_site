@model TeamPortfolio.Domain.Entities.Category
@{ ViewData["Title"] = "Edit Category"; }
<div class="d-flex align-items-center gap-3 mb-4">
    <a asp-action="Index" class="btn-ghost" style="cursor:pointer;"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i></a>
    <h1 style="font-size:1.5rem;margin:0;">Edit Category</h1>
</div>
<div class="card" style="cursor:default;max-width:480px;">
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        @Html.AntiForgeryToken()
        <div class="mb-3">
            <label for="name" class="form-label" style="font-size:0.875rem;color:var(--color-text-secondary);">Name *</label>
            <input type="text" id="name" name="name" class="form-control" value="@Model.Name" required />
        </div>
        <div class="mb-4">
            <label for="description" class="form-label" style="font-size:0.875rem;color:var(--color-text-secondary);">Description</label>
            <textarea id="description" name="description" class="form-control" rows="3">@Model.Description</textarea>
        </div>
        <button type="submit" class="btn-primary" style="cursor:pointer;"><i class="fa-solid fa-floppy-disk" aria-hidden="true"></i> Update</button>
        <a asp-action="Index" class="btn-secondary ms-2" style="cursor:pointer;">Cancel</a>
    </form>
</div>
