@model IEnumerable<TeamPortfolio.Domain.Entities.Category>
@{ ViewData["Title"] = "Categories"; }

<div class="d-flex align-items-center justify-content-between mb-4">
    <h1 style="font-size:1.5rem;margin:0;color:var(--color-moon-white);">Blog Categories</h1>
    <a asp-action="Create" class="btn-primary" style="cursor:pointer;"><i class="fa-solid fa-plus" aria-hidden="true"></i> Add</a>
</div>

@if (TempData["Success"] != null)
{ <div class="card mb-3" style="border-left:4px solid var(--color-success);cursor:default;"><p style="margin:0;color:var(--color-success);"><i class="fa-solid fa-circle-check me-2" aria-hidden="true"></i>@TempData["Success"]</p></div> }
@if (TempData["Error"] != null)
{ <div class="card mb-3" style="border-left:4px solid var(--color-danger);cursor:default;"><p style="margin:0;color:var(--color-danger);"><i class="fa-solid fa-circle-xmark me-2" aria-hidden="true"></i>@TempData["Error"]</p></div> }

<div class="card" style="cursor:default;overflow-x:auto;">
    <table style="width:100%;border-collapse:collapse;font-size:0.9rem;">
        <thead><tr style="border-bottom:1px solid var(--color-border);">
            <th style="padding:12px 16px;text-align:left;color:var(--color-parchment);font-weight:600;">Name</th>
            <th style="padding:12px 16px;text-align:left;color:var(--color-parchment);font-weight:600;">Description</th>
            <th style="padding:12px 16px;text-align:right;color:var(--color-parchment);font-weight:600;">Actions</th>
        </tr></thead>
        <tbody>
            @if (!Model.Any()) { <tr><td colspan="3" style="padding:3rem;text-align:center;color:var(--color-text-muted);">No categories yet.</td></tr> }
            @foreach (var cat in Model)
            {
                <tr style="border-bottom:1px solid var(--color-border);">
                    <td style="padding:12px 16px;font-weight:500;"><i class="fa-solid fa-tag me-2" style="color:var(--color-accent);" aria-hidden="true"></i>@cat.Name</td>
                    <td style="padding:12px 16px;color:var(--color-text-secondary);">@(cat.Description ?? "—")</td>
                    <td style="padding:12px 16px;text-align:right;">
                        <a asp-action="Edit" asp-route-id="@cat.Id" class="btn-ghost" style="cursor:pointer;margin-right:4px;" aria-label="Edit @cat.Name"><i class="fa-solid fa-pen fa-fw" aria-hidden="true"></i></a>
                        <button class="btn-ghost" onclick="confirmDelCat(@cat.Id,'@Html.Raw(cat.Name.Replace("'", "\\'"))')" style="cursor:pointer;color:var(--color-danger);" aria-label="Delete @cat.Name"><i class="fa-solid fa-trash fa-fw" aria-hidden="true"></i></button>
                        <form id="del-cat-@cat.Id" asp-action="Delete" asp-route-id="@cat.Id" method="post" style="display:none;">@Html.AntiForgeryToken()</form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js"></script>
<script>
function confirmDelCat(id, name) {
    Swal.fire({ title:'Delete Category?', text:'Delete "'+name+'"?', icon:'warning', showCancelButton:true,
        confirmButtonText:'Delete', confirmButtonColor:'var(--color-danger)', background:'var(--color-surface)', color:'var(--color-text)' })
    .then(r => { if(r.isConfirmed) document.getElementById('del-cat-'+id).submit(); });
}
</script>
}
